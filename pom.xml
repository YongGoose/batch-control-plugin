<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.jenkins-ci.plugins</groupId>
    <artifactId>plugin</artifactId>
    <version>6.2236.v12dd4c483242</version>
    <relativePath />
  </parent>

  <groupId>io.jenkins.plugins</groupId>
  <artifactId>batch-control</artifactId>
  <version>${revision}.${changelist}</version>
  <packaging>hpi</packaging>

  <name>Batch Control</name>
  <description>Adds run approval, time-boxed change permissions and an append-only audit history to Jenkins instances used as a batch execution manager</description>
  <url>https://github.com/jenkinsci/${project.artifactId}-plugin</url>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
    </license>
  </licenses>

  <scm>
    <connection>scm:git:https://github.com/jenkinsci/${project.artifactId}-plugin.git</connection>
    <developerConnection>scm:git:https://github.com/jenkinsci/${project.artifactId}-plugin.git</developerConnection>
    <tag>${scmTag}</tag>
    <url>https://github.com/jenkinsci/${project.artifactId}-plugin</url>
  </scm>

  <properties>
    <!-- Versions are ${revision}.${changelist}, the "manually controlled prefix" of
         https://www.jenkins.io/doc/developer/publishing/releasing-cd/ : CD releases are
         1.0.<commit count>.v<commit hash> (.mvn/maven.config: -Dchangelist.format=%d.v%s),
         local builds 1.0.999999-SNAPSHOT. Bump revision to 1.1 for a feature line or to 2.0
         for a breaking one; the third component is the commit count. -->
    <revision>1.0</revision>
    <changelist>999999-SNAPSHOT</changelist>
    <jenkins.baseline>2.568</jenkins.baseline>
    <jenkins.version>${jenkins.baseline}.3</jenkins.version>
    <hpi.strictBundledArtifacts>true</hpi.strictBundledArtifacts>
    <!-- D-70: the new job page's request dialogs return jenkins.model.menu.event.DialogEvent
         from Action#getEvent(), the API core's Build with Parameters uses, which is
         @Restricted(Beta) in core 2.568.x. useBeta lets the access-modifier checker accept it. -->
    <useBeta>true</useBeta>
    <!-- Parallelize surefire across whole test classes (reuseForks stays as the parent
         POM defines, i.e. false: a fresh JVM per test class); this only widens how many
         of those per-class forks run concurrently. Each fork starts a Jenkins, so 1C
         can run out of memory on a many-core machine or in a memory-limited container;
         run with -DforkCount=4 there (CONTRIBUTING.md, "Commands"). 1C stays the
         default because the CI runners are small (4 cores on ubuntu-latest). -->
    <forkCount>1C</forkCount>
    <!-- D-35g: 927 is the minimum supported role-strategy (see the dependency below).
         A property only so that the scheduled role-strategy-latest workflow can
         test against the newest release with -Drole-strategy.version=...; keep the
         default at the minimum. -->
    <role-strategy.version>927.v9cf5527c4085</role-strategy.version>
    <ban-commons-lang-2.skip>false</ban-commons-lang-2.skip>
    <ban-deprecated-stapler.skip>false</ban-deprecated-stapler.skip>
    <ban-junit4-imports.skip>false</ban-junit4-imports.skip>
    <banObsoleteDependencyOverrides.skip>false</banObsoleteDependencyOverrides.skip>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.jenkins.tools.bom</groupId>
        <artifactId>bom-${jenkins.baseline}.x</artifactId>
        <version>7093.v37de7b_4a_8a_4f</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <!-- Not BOM-managed. mailer 534.v1b_36f5864073 pulls in io.jenkins.plugins:jakarta-mail-api
           (jakarta.mail-api 2.1.5), so mock-javamail must be a Jakarta Mail (2.x) release, not the
           legacy javax.mail 1.x line. 2.2 is the latest published to repo.jenkins-ci.org and depends
           on jakarta.mail-api 2.1.3, which resolves cleanly alongside 2.1.5 on the classpath.
           Declared FIRST: Maven orders the test classpath by declaration, and Jakarta Mail keeps the
           first META-INF/javamail.providers entry per protocol, so this must precede angus-mail
           (pulled in via workflow-basic-steps / mailer -> jakarta-mail-api) or SMTP goes to localhost:25. -->
      <groupId>org.jvnet.mock-javamail</groupId>
      <artifactId>mock-javamail</artifactId>
      <version>2.2</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.jenkins-ci.plugins</groupId>
      <artifactId>cloudbees-folder</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jenkins-ci.plugins.workflow</groupId>
      <artifactId>workflow-job</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.jenkins-ci.plugins.workflow</groupId>
      <artifactId>workflow-cps</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.jenkins-ci.plugins.workflow</groupId>
      <artifactId>workflow-basic-steps</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- The Pipeline `build` step lives in pipeline-build-step, not workflow-basic-steps. -->
      <groupId>org.jenkins-ci.plugins</groupId>
      <artifactId>pipeline-build-step</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.jenkins-ci.plugins</groupId>
      <artifactId>matrix-auth</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <!-- BOM-managed (io.jenkins.tools.bom:bom-2.568.x). Optional: notification mail is
           only sent when the Mailer plugin is installed alongside batch-control. -->
      <groupId>org.jenkins-ci.plugins</groupId>
      <artifactId>mailer</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.jenkins-ci.plugins</groupId>
      <artifactId>job-dsl</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.jenkins-ci.plugins</groupId>
      <artifactId>role-strategy</artifactId>
      <!-- D-35g: 927 is the minimum supported role-strategy (redesigned Assign Roles
           page); the Batch Control descriptor forwards to its descriptor methods. The BOM
           still manages 898, which also replaced the variant on a Manage Roles save (D-35f).
           Overrides the BOM version on purpose. -->
      <version>${role-strategy.version}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <!-- D-35g: @SuppressRestrictedWarnings, so the Batch Control role strategy's
           descriptor can forward to role-strategy's restricted descriptor methods.
           Compile-time only; same version as the parent's access-modifier-checker. -->
      <groupId>org.kohsuke</groupId>
      <artifactId>access-modifier-suppressions</artifactId>
      <version>${access-modifier-checker.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>io.jenkins</groupId>
      <artifactId>configuration-as-code</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.jenkins-ci.plugins.workflow</groupId>
      <artifactId>workflow-multibranch</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.jenkins.plugins</groupId>
      <artifactId>ionicons-api</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <!-- BOM-managed. Bounded, expiring caches (R4-2) use the Caffeine API plugin instead of
           a hand-written cache. Required plugin dependency. -->
      <groupId>io.jenkins.plugins</groupId>
      <artifactId>caffeine-api</artifactId>
    </dependency>

    <!-- Test-only dependencies for plugin interaction tests. -->
    <!-- BOM-managed (versions supplied by io.jenkins.tools.bom:bom-2.568.x via bom-weekly). -->
    <dependency>
      <!-- Optional compile dependency (not test-only): RebuildValidator (policy) needs the
           rebuild API at compile time (e2e-03 DEF-25). Remains on the test classpath too,
           since compile scope is inherited by test. -->
      <groupId>com.sonyericsson.hudson.plugins.rebuild</groupId>
      <artifactId>rebuild</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.jenkins-ci.plugins</groupId>
      <artifactId>parameterized-trigger</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.jenkins-ci.plugins</groupId>
      <artifactId>build-token-root</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.jenkins-ci.plugins</groupId>
      <artifactId>naginator</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.6wind.jenkins</groupId>
      <artifactId>lockable-resources</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.jenkins-ci.plugins</groupId>
      <artifactId>throttle-concurrents</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.jenkins-ci.plugins</groupId>
      <artifactId>authorize-project</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.jenkins-ci.plugins</groupId>
      <artifactId>jobConfigHistory</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- Declarative Pipeline, for the Restart from Stage test (T-02-79, D-58b). -->
      <groupId>org.jenkinsci.plugins</groupId>
      <artifactId>pipeline-model-definition</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- Optional compile dependency (D-74(2)): the store and policy code reference the
           file-parameters types (AbstractFileParameterValue and its filename) directly,
           behind an optional guard, instead of class-name checks and reflection. Batch Control
           loads without the plugin; when it is installed it must be at least this version.
           D-72: tests also submit this plugin's stashedFile and base64File parameters and
           read them back in a Pipeline with withFileParameter / unstash inside node (core's
           file parameter needs no extra dependency). unstash and readFile come from
           workflow-basic-steps, node from workflow-durable-task-step (a required dependency
           of workflow-basic-steps). -->
      <groupId>io.jenkins.plugins</groupId>
      <artifactId>file-parameters</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <!-- Matrix projects in tests: ActivationMatrixConfigurationTest (D-82, T-06a-58..62, a
           configuration follows its parent's run control) and the item-kind tests. Declared
           directly rather than relying on the transitive copy through rebuild. Test scope only:
           the main code does not reference hudson.matrix. -->
      <groupId>org.jenkins-ci.plugins</groupId>
      <artifactId>matrix-project</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Not BOM-managed; pinned to latest release supporting jenkins.baseline 2.568 (requiredCore 2.516.3). -->
    <dependency>
      <groupId>org.jenkins-ci.plugins</groupId>
      <artifactId>customize-build-now</artifactId>
      <version>53.v64eb_d7d017d2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <!-- T-02-122 (D-35g): RoleStrategyTooOldRealJenkinsTest installs role-strategy 898,
             older than the 927 minimum, next to batch-control and expects the refusal. The old hpi is copied as a plain
             file into the test output directory (old-plugins/role-strategy.hpi); it is not a
             dependency, so it is not on the test classpath, not in the hpi's manifest and not
             seen by the enforcer or hpi.strictBundledArtifacts. -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-old-role-strategy</id>
            <phase>process-test-resources</phase>
            <goals>
              <goal>copy</goal>
            </goals>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>org.jenkins-ci.plugins</groupId>
                  <artifactId>role-strategy</artifactId>
                  <version>898.vc050ed2424ca_</version>
                  <type>hpi</type>
                  <outputDirectory>${project.build.testOutputDirectory}/old-plugins</outputDirectory>
                  <destFileName>role-strategy.hpi</destFileName>
                </artifactItem>
              </artifactItems>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <!-- ci.jenkins.io runs only the tests tagged @Tag("core") (the criteria are in
           docs/TEST-MATRIX.md, note 330). The whole suite takes about 103 minutes on four forks
           there, longer than buildPlugin's 60-minute default, and spot agents get reclaimed
           during so long a run (jenkinsci/batch-control-plugin#80). GitHub Actions runs every
           test: build.yml on Linux with JDK 21 and 25, windows-tests.yml on Windows with JDK 21.

           Active only when Maven runs inside a Jenkins build, which sets JENKINS_URL. GitHub
           Actions and local builds do not set it, so they still run everything. To run
           everything inside a Jenkins build anyway, add -P '!core-tests-on-jenkins'.

           default-test keeps only the core tag. The InjectedTest that maven-hpi-plugin
           generates (the plugin's automatic checks) has no tag, so that filter would drop it;
           the injected-test execution runs it on its own. While no test carries the tag,
           default-test runs nothing and passes (Surefire's failIfNoTests defaults to false). -->
      <id>core-tests-on-jenkins</id>
      <activation>
        <property>
          <name>env.JENKINS_URL</name>
        </property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <artifactId>maven-surefire-plugin</artifactId>
            <executions>
              <execution>
                <id>default-test</id>
                <configuration>
                  <groups>core</groups>
                </configuration>
              </execution>
              <execution>
                <id>injected-test</id>
                <goals>
                  <goal>test</goal>
                </goals>
                <configuration>
                  <test>InjectedTest</test>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

  <repositories>
    <repository>
      <id>repo.jenkins-ci.org</id>
      <url>https://repo.jenkins-ci.org/public/</url>
    </repository>
  </repositories>

  <pluginRepositories>
    <pluginRepository>
      <id>repo.jenkins-ci.org</id>
      <url>https://repo.jenkins-ci.org/public/</url>
    </pluginRepository>
  </pluginRepositories>
</project>
