<?jelly escape-by-default='true'?>
<!-- e2e-03 DEF-09: the refusal message of a whole form (one not about a single field), rendered
     above the form. Plain escaped text only. -->
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler">
  <st:documentation>
    The form-level message a refused submission left (ui.FormErrors).
    <st:attribute name="errors" use="required">The FormErrors of the form.</st:attribute>
  </st:documentation>
  <j:if test="${attrs.errors.present}">
    <div class="jenkins-alert jenkins-alert-danger" role="alert" data-batch-control-form-error="${attrs.errors.form}">
      <j:choose>
        <j:when test="${attrs.errors.message != null}">${attrs.errors.message}</j:when>
        <j:otherwise>Nothing was submitted. Correct the fields marked below and submit again; what you entered has been kept.</j:otherwise>
      </j:choose>
    </div>
  </j:if>
</j:jelly>
