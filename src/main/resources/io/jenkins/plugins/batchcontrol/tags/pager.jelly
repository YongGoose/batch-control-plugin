<?jelly escape-by-default='true'?>
<!-- D-66: the footer of one of the Pending, Active and Ended lists, 50 rows a page (ui.Paging):
     always "Page N (M requests)", singular for one (E2E-1 UX-9), with the total counted over the
     rows the viewer may see (S-16: a count must not reveal hidden requests), and Previous/Next
     links when there are more pages. Each list pages with its own query parameter; a link keeps
     every other parameter of the current URL, so paging one list leaves the others where they
     are (#45, ui.Paging#query). -->
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler">
  <st:documentation>
    Paging links of one list.
    <st:attribute name="param" use="required">Query parameter of this list's page.</st:attribute>
    <st:attribute name="page" use="required">Current 1-based page.</st:attribute>
    <st:attribute name="total" use="required">Number of rows in the list.</st:attribute>
    <st:attribute name="hasPrevious" use="required">Whether a newer page exists.</st:attribute>
    <st:attribute name="hasNext" use="required">Whether an older page exists.</st:attribute>
    <st:attribute name="label" use="required">Accessible name of the list, for example "pending requests".</st:attribute>
    <st:attribute name="singular" use="required">The counted noun for one row, for example "request".</st:attribute>
    <st:attribute name="plural" use="required">The counted noun for other counts, for example "requests".</st:attribute>
  </st:documentation>
  <div class="jenkins-buttons-row jenkins-!-margin-top-1" role="navigation" aria-label="Pages of ${attrs.label}">
      <j:if test="${attrs.hasPrevious}">
        <j:invokeStatic var="pagerPrevious" className="io.jenkins.plugins.batchcontrol.ui.Paging" method="query">
          <j:arg type="java.lang.String" value="${attrs.param}"/>
          <j:arg type="int" value="${attrs.page - 1}"/>
        </j:invokeStatic>
        <a class="jenkins-button" href="?${pagerPrevious}">Previous</a>
      </j:if>
      <span>Page ${attrs.page} (${attrs.total} ${attrs.total == 1 ? attrs.singular : attrs.plural})</span>
      <j:if test="${attrs.hasNext}">
        <j:invokeStatic var="pagerNext" className="io.jenkins.plugins.batchcontrol.ui.Paging" method="query">
          <j:arg type="java.lang.String" value="${attrs.param}"/>
          <j:arg type="int" value="${attrs.page + 1}"/>
        </j:invokeStatic>
        <a class="jenkins-button" href="?${pagerNext}">Next</a>
      </j:if>
    </div>
</j:jelly>
