<?jelly escape-by-default='true'?>
<!--
  D-35a (ARCHITECTURE section 4): change control is on, but the installed authorization
  strategy is not a Batch Control strategy, so active grants confer nothing. Covers an
  instance that never migrated and a plain strategy installed on the global security page or
  by JCasC (role-strategy 918+ keeps the installed Batch Control class on its own pages, D-35f).
  This text and the migration control only show while it.strategyUnsupported.
  The migration button only shows when the installed strategy is a plain matrix-auth or
  role-strategy configuration this plugin can copy (it.migratable), to Administer holders.
  When the installed strategy is matrix-auth's global matrix, converting makes per-item
  authorization properties effective again (D-35d (3), it.perItemWidening): the warning is a
  warning-styled paragraph, the first block of the monitor body, and the button (in the
  controls slot) asks for confirmation through core's l:confirmationLink.

  D-35d (2): change control is on but no build authenticator is configured, so builds run as
  SYSTEM and can change authorization outside the self-grant guard (it.buildAuthenticatorMissing).
  This condition is independent of strategyUnsupported and shows in its own paragraph.
-->
<j:jelly xmlns:j="jelly:core" xmlns:l="/lib/layout">
  <j:set var="controls">
    <!-- e2e-04 FD-01: doMigrate needs Overall/Administer; the control is only for its holders.
         When converting would make per-item properties effective, core's l:confirmationLink
         (POST with the crumb added by core's script) asks for confirmation first. -->
    <j:if test="${it.strategyUnsupported and it.migratable and app.hasPermission(app.ADMINISTER)}">
      <j:choose>
        <j:when test="${it.perItemWidening}">
          <l:confirmationLink href="${rootURL}/${it.url}/migrate" post="true" class="jenkins-button"
                              title="Install the Batch Control variant?"
                              message="Per-item authorization properties on folders, jobs and agents become effective and start granting the permissions they list."
                              okText="Install">Install the Batch Control variant</l:confirmationLink>
        </j:when>
        <j:otherwise>
          <form method="post" action="${rootURL}/${it.url}/migrate">
            <button type="submit" class="jenkins-button">Install the Batch Control variant</button>
          </form>
        </j:otherwise>
      </j:choose>
    </j:if>
  </j:set>
  <l:adminMonitor severity="warning" controls="${controls}">
    <j:if test="${it.strategyUnsupported}">
      <j:if test="${it.perItemWidening}">
        <!-- e2e-06 DEF-04: no icon of its own, the alert already shows the monitor's icon. -->
        <div class="jenkins-!-warning-color" style="margin-bottom: 0.5rem;">
          <strong>Before you install:</strong> converting from the installed global matrix
          strategy makes per-item authorization properties effective. Any per-item authorization
          property already present on a folder, job or agent will start granting the permissions
          it lists. Check those properties first.
        </div>
      </j:if>
      <div>
        <strong>Batch Control:</strong> change control is enabled, but the installed authorization
        strategy (${it.installedStrategyName ?: 'none'}) is not a Batch Control strategy, so active
        grants do not confer any permission. Install the matching Batch Control strategy to restore
        just-in-time change control.
      </div>
    </j:if>
    <j:if test="${it.buildAuthenticatorMissing}">
      <p>
        <strong>Batch Control:</strong> change control is enabled, but no build authenticator is
        configured, so builds run as SYSTEM. A build (for example a Pipeline <code>properties</code>
        step or a Job DSL seed job) can then change authorization outside Batch Control's
        self-grant guard. Install and configure
        <a href="https://plugins.jenkins.io/authorize-project/">Authorize Project</a> under
        <a href="${rootURL}/manage/configureSecurity">Security</a>.
      </p>
    </j:if>
    <!-- D-50a (SPEC item 2): one fixed warning with no job names, while change control is on and
         builds can run as SYSTEM or as an account with Configure (D-50b,
         BatchControlStrategyMonitor#isBuildsMayRunAsSystem). -->
    <j:if test="${it.buildsMayRunAsSystem}">
      <p>
        <strong>Batch Control:</strong> builds on this instance can run as SYSTEM or as an account
        that already has Configure permission, so a holder of a Configure permission window can
        make a build change a job's permissions permanently. Set a global default build
        authorization in <a href="https://plugins.jenkins.io/authorize-project/">Authorize Project</a>
        under <a href="${rootURL}/manage/configureSecurity">Security</a> that runs every build as
        an account without Configure permission (for example "Run as Specific User" with a
        dedicated low-privilege account). "Run as the user who triggered the build" is only safe
        together with such a fallback, because timer and SCM builds have no triggering user. A
        strategy on a single job is not enough.
      </p>
    </j:if>
    <!-- D-58a (4): items in the "changed under a grant" state (at most 50, sorted), from
         BatchControlStrategyMonitor#getItemsChangedUnderGrant. Administrator-only page; names are
         escaped by default. An item that no longer resolves is listed as plain text. -->
    <j:set var="changedItems" value="${it.itemsChangedUnderGrant}"/>
    <!-- D-58c: the marked runs come from the Batch Control root action (ui.ReplayedRuns). -->
    <j:set var="bcRoot" value="${app.getExtensionList('io.jenkins.plugins.batchcontrol.action.BatchControlRootAction').get(0)}"/>
    <j:if test="${!empty(changedItems)}">
      <p>
        <strong>Batch Control:</strong> these items were changed under a temporary permission
        window and have not been reviewed. Until one of them is marked as reviewed (below, or by a
        user with Configure permission and Batch Control/Request on the job's Batch Control
        page), changes that widen its authorization are undone, whoever saves it. Saving the
        item does not end this.
      </p>
      <!-- D-58b (3): a deliberate review per item (POST, crumb added to every POST form by
           Jenkins; BatchControlStrategyMonitor#doMarkReviewed checks Administer). -->
      <p>
        Check what was changed under the permission window (see
        <a href="${rootURL}/batch-control/changes/">Change Records</a>) and the Pipeline script
        first, then mark the item as reviewed.
      </p>
      <ul>
        <j:forEach var="name" items="${changedItems}">
          <j:set var="changedItem" value="${app.getItemByFullName(name)}"/>
          <li>
            <j:choose>
              <j:when test="${changedItem != null}">
                <a href="${rootURL}/${changedItem.url}configure"><code>${name}</code></a>
                <j:set var="itemRuns" value="${bcRoot.markedRuns(name)}"/>
                <j:if test="${!empty(itemRuns)}">
                  <div>These runs were replayed under a temporary permission window; only an administrator can re-run them.</div>
                  <ul>
                    <j:forEach var="r" items="${itemRuns}">
                      <li>
                        <j:choose>
                          <j:when test="${r.url != null}"><a href="${rootURL}/${r.url}">${r.id}</a></j:when>
                          <j:otherwise>${r.id}</j:otherwise>
                        </j:choose>
                      </li>
                    </j:forEach>
                  </ul>
                </j:if>
                <!-- e2e-06 DEF-04: not a form, core floats every form in a monitor body to the
                     right edge. core's l:confirmationLink POSTs (crumb added by core's script)
                     with the item as the single query parameter doMarkReviewed reads. -->
                <l:confirmationLink href="${rootURL}/${it.url}/markReviewed?item=${h.urlEncode(name)}" post="true"
                                    class="jenkins-button jenkins-button--tertiary jenkins-!-margin-left-1"
                                    title="Mark ${name} as reviewed?"
                                    message="Changes that widen its authorization are no longer undone."
                                    okText="Mark as reviewed">Mark as reviewed</l:confirmationLink>
              </j:when>
              <j:otherwise><code>${name}</code></j:otherwise>
            </j:choose>
          </li>
        </j:forEach>
      </ul>
    </j:if>
  </l:adminMonitor>
</j:jelly>
