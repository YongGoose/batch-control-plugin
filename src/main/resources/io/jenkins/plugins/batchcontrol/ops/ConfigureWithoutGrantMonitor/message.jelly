<?jelly escape-by-default='true'?>
<!-- SPEC item 8 monitor. e2e-03 DEF-07: the message says which of its two causes applies and names
     the users and groups the scan found, so the administrator knows what to fix.
     View model (ConfigureWithoutGrantMonitor): isStrategyMissing(), getStandingUsers(),
     getStandingGroups(); each StandingHolder has getSid(), getDisplayName(), isGroup() and
     getPermissions(). User and group names are user input: escaped by default, never raw. -->
<j:jelly xmlns:j="jelly:core" xmlns:l="/lib/layout">
  <j:set var="controls">
    <a class="jenkins-button" href="${rootURL}/manage/configureSecurity">Review authorization strategy</a>
  </j:set>
  <l:adminMonitor severity="warning" controls="${controls}">
    <j:choose>
      <j:when test="${it.strategyMissing}">
        <strong>Batch Control:</strong> change control is enabled, but the installed
        authorization strategy is not a Batch Control strategy, so change permission windows
        (grants) can never apply. Choose "Batch Control: Project-based Matrix Authorization Strategy" or
        "Batch Control: Role-Based Strategy" under Manage Jenkins, Security. Until then changes
        are only recorded in the audit history.
      </j:when>
      <j:otherwise>
        <!-- e2e re-audit DEF-29: users and groups in one table, each row naming its kind
             ("User" or "Group"), its sid as written in the strategy and every permission found,
             so a group entry reads exactly like a user entry. -->
        <strong>Batch Control:</strong> change control is enabled, but the entries below hold
        Item Create/Configure/Delete directly from the authorization strategy, outside the
        just-in-time grant flow. Changes made through them bypass grant control and are only
        recorded in the audit history.
        <table class="jenkins-table jenkins-table--small" style="margin: 0.5rem 0; width: auto;">
          <thead>
            <tr>
              <th scope="col">Kind</th>
              <th scope="col">User or group</th>
              <th scope="col">Standing permissions</th>
            </tr>
          </thead>
          <tbody>
            <j:forEach var="h" items="${it.standingUsers}">
              <tr>
                <td>User</td>
                <td><code>${h.sid}</code><j:if test="${h.displayName != h.sid}"> (${h.displayName})</j:if></td>
                <td><j:forEach var="p" items="${h.permissions}" varStatus="st">${p}<j:if test="${!st.last}">, </j:if></j:forEach></td>
              </tr>
            </j:forEach>
            <j:forEach var="h" items="${it.standingGroups}">
              <tr>
                <td>Group</td>
                <td>
                  <code>${h.sid}</code>
                  <j:if test="${h.sid == 'authenticated'}"> (every logged-in user)</j:if>
                </td>
                <td><j:forEach var="p" items="${h.permissions}" varStatus="st">${p}<j:if test="${!st.last}">, </j:if></j:forEach></td>
              </tr>
            </j:forEach>
          </tbody>
        </table>
        Only the global authorization is scanned; per-folder and per-job entries are not listed.
      </j:otherwise>
    </j:choose>
  </l:adminMonitor>
</j:jelly>
