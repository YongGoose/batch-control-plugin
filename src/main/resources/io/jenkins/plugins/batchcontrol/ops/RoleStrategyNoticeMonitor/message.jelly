<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:l="/lib/layout">
  <l:adminMonitor severity="info">
    <strong>Batch Control:</strong> the Role Strategy plugin is the active authorization
    strategy. Just-in-time change permissions (grants) are not supported on Role Strategy in
    this release; run control and audit recording still work. See the plugin README for known
    limitations.
  </l:adminMonitor>
</j:jelly>
