<?jelly escape-by-default='true'?>
<!-- Backlog #86 (e2e-09 DEF-03): the strategy monitor's "Mark as reviewed" lands here; the
     confirmation itself is /batch-control/reviewed (BatchControlRootAction/reviewed.jelly), whose
     breadcrumb names the page instead of the monitor. Served below the administrative monitor,
     which Jenkins only lets Administer holders reach. The item is passed on URL-encoded and is
     resolved, never echoed, by the target page. -->
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler">
  <!-- No l:layout here, so neither rootURL nor h is set (as in core's own redirect views): the
       context path comes from the request and h is created the way l:layout does. -->
  <j:new var="h" className="hudson.Functions"/>
  <j:set var="reviewedItem" value="${request2.getParameter('item')}"/>
  <j:set var="reviewedQuery" value=""/>
  <j:if test="${reviewedItem != null}">
    <j:set var="reviewedQuery" value="${h.urlEncode(reviewedItem)}"/>
  </j:if>
  <st:redirect url="${request2.contextPath}/batch-control/reviewed?item=${reviewedQuery}"/>
</j:jelly>
