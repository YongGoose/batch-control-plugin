<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:l="/lib/layout" xmlns:f="/lib/form">
  <l:layout title="Run Request ${it.id}" type="one-column" permissions="${it.viewPermissions}">
    <l:main-panel>
      <l:app-bar title="Run Request ${it.id}"/>

      <table class="jenkins-table jenkins-table--small">
        <tbody>
          <tr>
            <th style="text-align: left; width: 12rem;">Job</th>
            <td>
              <j:choose>
                <j:when test="${it.jobUrl != null}">
                  <a href="${rootURL}/${it.jobUrl}">${it.request.jobFullName}</a>
                </j:when>
                <j:otherwise>${it.request.jobFullName}</j:otherwise>
              </j:choose>
            </td>
          </tr>
          <tr><th style="text-align: left;">Status</th><td>${it.request.status}</td></tr>
          <tr><th style="text-align: left;">Requester</th><td>${it.request.requester}</td></tr>
          <tr><th style="text-align: left;">Approvers</th><td>${it.join(it.request.approvers)}</td></tr>
          <tr><th style="text-align: left;">Created</th><td>${it.format(it.request.createdAt)}</td></tr>
          <tr><th style="text-align: left;">Decided</th><td>${it.format(it.request.decidedAt)}</td></tr>
          <j:if test="${it.request.decidedBy != null}">
            <tr><th style="text-align: left;">Decided by</th><td>${it.request.decidedBy}</td></tr>
          </j:if>
          <j:if test="${it.request.decisionComment != null}">
            <tr><th style="text-align: left;">Decision comment</th><td>${it.request.decisionComment}</td></tr>
          </j:if>
          <j:if test="${it.request.selfApproved}">
            <tr><th style="text-align: left;">Self-approved</th><td>Yes</td></tr>
          </j:if>
          <j:if test="${it.request.executedRunId != null}">
            <tr>
              <th style="text-align: left;">Executed run</th>
              <td>
                <j:choose>
                  <j:when test="${it.executedRunUrl != null}">
                    <a href="${rootURL}/${it.executedRunUrl}">${it.request.executedRunId}</a>
                  </j:when>
                  <j:otherwise>${it.request.executedRunId}</j:otherwise>
                </j:choose>
              </td>
            </tr>
          </j:if>
        </tbody>
      </table>

      <h2>Reason</h2>
      <p style="white-space: pre-wrap;">${it.request.reason}</p>

      <h2>Parameters</h2>
      <j:choose>
        <j:when test="${empty(it.request.parameters)}">
          <p>No parameters.</p>
        </j:when>
        <j:otherwise>
          <table class="jenkins-table">
            <thead>
              <tr><th>Name</th><th>Value</th></tr>
            </thead>
            <tbody>
              <j:forEach var="p" items="${it.request.parameters.entrySet()}">
                <tr>
                  <td>${p.key}</td>
                  <td style="white-space: pre-wrap;">${p.value}</td>
                </tr>
              </j:forEach>
            </tbody>
          </table>
        </j:otherwise>
      </j:choose>

      <!-- T-E2E-05: the approver decides on one screen. The rows come from the permission-aware
           job lookup (P-09), so a job that is deleted or invisible to this user shows no runs. -->
      <h2>Recent Runs of This Job</h2>
      <j:choose>
        <j:when test="${it.jobUrl == null}">
          <p>The job is not available: it has been deleted, or you may not view it.</p>
        </j:when>
        <j:when test="${empty(it.recentRuns)}">
          <!-- No size control here on purpose: with no rows to size, a "Runs to show" selector
               would only offer to re-render the same empty screen. -->
          <p>This job has no runs yet.</p>
        </j:when>
        <j:otherwise>
          <table class="jenkins-table">
            <thead>
              <tr><th>Build</th><th>Result</th><th>Started</th><th>Duration</th></tr>
            </thead>
            <tbody>
              <j:forEach var="r" items="${it.recentRuns}">
                <tr>
                  <td><a href="${rootURL}/${r.url}">#${r.number}</a></td>
                  <td>${r.result}</td>
                  <td>${r.started}</td>
                  <td>${r.duration}</td>
                </tr>
              </j:forEach>
            </tbody>
          </table>

          <!-- Size control, below the table so the runs stay the first thing read. Links, not a
               form: reading a different number of rows never changes state, so it needs no CSRF
               crumb - but Jenkins core's hudson-behavior.js appends the crumb and a "json" blob to
               every <form> on every page, which on a GET form lands them in the address bar, the
               browser history, the Referer header and every proxy log. Links keep the result at a
               single bookmarkable "?runs=20" and carry no crumb at all. Same shape as the History
               tabs and the pagination links elsewhere in this plugin; the current size is marked
               both by the primary style and by aria-current for non-visual clients. The four
               offered sizes are the only ones the server honours (RequestItem#getRecentRunLimit),
               so editing ?runs= by hand cannot make this page read more build history than the
               largest one. -->
          <div style="margin-top: 0.75rem; display: flex; gap: 1rem; align-items: center; flex-wrap: wrap;">
            <span class="jenkins-description" style="margin: 0;">
              <j:choose>
                <j:when test="${it.recentRunsTruncated}">
                  Showing the ${it.recentRunCount} most recent of this job's runs.
                </j:when>
                <j:otherwise>
                  Showing all ${it.recentRunCount} run(s) this job has.
                </j:otherwise>
              </j:choose>
            </span>
            <nav aria-labelledby="batch-control-runs-label"
                 style="display: flex; gap: 0.5rem; align-items: center;">
              <span id="batch-control-runs-label">Runs to show:</span>
              <j:forEach var="n" items="${it.recentRunLimitOptions}">
                <j:choose>
                  <j:when test="${n == it.recentRunLimit}">
                    <a class="jenkins-button jenkins-button--primary" href="?runs=${n}"
                       aria-current="true">${n}</a>
                  </j:when>
                  <j:otherwise>
                    <a class="jenkins-button" href="?runs=${n}">${n}</a>
                  </j:otherwise>
                </j:choose>
              </j:forEach>
            </nav>
          </div>
        </j:otherwise>
      </j:choose>

      <j:if test="${!empty(it.request.approverChanges)}">
        <h2>Approver Changes</h2>
        <table class="jenkins-table">
          <thead>
            <tr><th>From</th><th>To</th><th>Changed by</th><th>At</th></tr>
          </thead>
          <tbody>
            <j:forEach var="c" items="${it.request.approverChanges}">
              <tr>
                <td>${it.join(c.fromApprovers)}</td>
                <td>${it.join(c.toApprovers)}</td>
                <td>${c.by}</td>
                <td>${it.format(c.at)}</td>
              </tr>
            </j:forEach>
          </tbody>
        </table>
      </j:if>

      <j:if test="${it.canDecide}">
        <h2>Decision</h2>
        <f:form method="post" action="approve" name="approve">
          <f:entry title="Comment (optional)">
            <f:textarea name="comment" value=""/>
          </f:entry>
          <f:bottomButtonBar>
            <f:submit value="Approve"/>
          </f:bottomButtonBar>
        </f:form>
        <f:form method="post" action="reject" name="reject">
          <f:entry title="Rejection comment (required)" description="Rejection is final for this request; a rejected request cannot be reopened.">
            <f:textarea name="comment" value=""/>
          </f:entry>
          <f:bottomButtonBar>
            <button type="submit" class="jenkins-button jenkins-button--destructive">Reject</button>
          </f:bottomButtonBar>
        </f:form>
      </j:if>

      <!-- UX-10: approving redirects here, but the APPROVED -> EXECUTED transition and the build
           number are written by the execution listener afterwards, so this page is one refresh
           behind. Say so in plain text: no meta refresh and no script, deliberately. Shown only
           while the request is APPROVED with no run recorded yet, never for EXECUTED, REJECTED,
           CANCELLED, EXPIRED or INVALIDATED.

           The id is a stable hook for tests: it lets a test assert the notice itself is present or
           absent without knowing its wording, so the wording can be reworded freely. Keep it. -->
      <j:if test="${it.awaitingExecution}">
        <div id="batch-control-approved-notice" class="jenkins-alert jenkins-alert-info"
             style="margin-top: 1rem;">
          This request is approved and the run starts shortly. Reload this page to see the status
          change to EXECUTED and the build number appear.
        </div>
      </j:if>

      <j:if test="${it.canChangeApprover}">
        <h2>Change Approvers</h2>
        <j:choose>
          <j:when test="${empty(it.approverOptions)}">
            <div class="jenkins-alert jenkins-alert-warning">
              No approvers are configured. Ask an administrator to add approvers in the Batch Control global configuration.
            </div>
          </j:when>
          <j:otherwise>
            <!-- D-26, D-37: the picker starts on the current set, so unchecking one member and
                 checking another edits the set; the change is recorded as (previous set, new set). -->
            <f:form method="post" action="changeApprover" name="changeApprover">
              <f:entry title="Approvers" description="Any one of the checked approvers may decide."
                       help="/plugin/batch-control/help/approvers.html">
                <j:forEach var="a" items="${it.approverOptions}" varStatus="s">
                  <div class="jenkins-!-margin-bottom-1">
                    <f:checkbox name="approvers" value="${a}" id="batch-control-approver-${s.index}"
                                title="${a}" checked="${it.isDesignated(a)}"/>
                  </div>
                </j:forEach>
              </f:entry>
              <f:bottomButtonBar>
                <f:submit value="Change Approvers"/>
              </f:bottomButtonBar>
            </f:form>
          </j:otherwise>
        </j:choose>
      </j:if>

      <j:if test="${it.canCancel}">
        <h2>Cancel</h2>
        <p>
          <l:confirmationLink href="cancel" post="true" title="Cancel this run request?"
                              message="The request will be closed as CANCELLED. This cannot be undone.">
            Cancel Request
          </l:confirmationLink>
        </p>
      </j:if>
    </l:main-panel>
  </l:layout>
</j:jelly>
