<?jelly escape-by-default='true'?>
<!-- SPEC item 6a (and item 6 for the approval notice below): the job page says whether the job is in service for unattended triggers and
     links to the activation request form. Rendered for every action by the job main page; shown
     while run control is on to viewers holding Item/Read, whatever approvalRequired says (D-46a,
     JobActivationNoticeAction#isShown). The form link is rendered only for a Request holder. A
     computed child (branch job) shows the state of the computed folder that carries its
     activation (D-46c), linking to that folder only for a viewer who may read it.
     Only constant text, request ids and statuses are rendered; no script.

     Wording contract: an activated job's notice must not contain the phrases used for the other
     two states, so "Request a hold" rather than any phrase with "on hold" in it. -->
<!-- #72: shared by jobMain.jelly (classic job page, noticeClass = a top margin) and
     JobNoticesWidget/index.jelly (new job page card, no extra class). D-74: core's utility
     classes instead of inline styles. -->
<j:jelly xmlns:j="jelly:core">
  <j:if test="${it.shown}">
    <!-- e2e-03 DEF-01 (SPEC item 6): on an approval-required job the page always says that manual
         runs need an approved request, since another plugin's build button (Rebuild, Retry, a
         customised Build Now) only reports a refusal as its own generic failure. The request form
         link (not worded "Request Run": exactly one element, the sidebar entry, reads that, U-02) is rendered only for a Request holder (the form answers 404 to anyone else). -->
    <j:if test="${it.approvalRequired}">
      <div class="jenkins-alert jenkins-alert-info ${noticeClass}" role="status">
        <strong>Batch Control: manual runs of this job need an approved run request.</strong>
        A build started any other way (a build URL, the CLI, Rebuild, Retry or another plugin's
        build button) is refused without one, even where the button only reports a generic
        failure.
        <j:choose>
          <j:when test="${it.canRequestRun}">
            <a href="${rootURL}/${it.job.url}batch-control/">Open the run request form</a>; the
            build starts automatically once the request is approved.
          </j:when>
          <j:otherwise>
            Ask a user who may submit run requests, an approver or a Jenkins administrator to
            request the run for you.
          </j:otherwise>
        </j:choose>
      </div>
    </j:if>
    <j:set var="formUrl" value="${rootURL}/${it.job.url}batch-control-activation/"/>
    <j:set var="carrier" value="${it.carrier}"/>
    <j:choose>
      <j:when test="${carrier != null}">
        <j:set var="carrierUrl" value="${it.carrierUrl(carrier)}"/>
        <div class="jenkins-alert jenkins-alert-info ${noticeClass}" role="status">
          <!-- S-14-02: the carrier's name and state only for a viewer with Item/Read on it
               (carrierUrl is null otherwise); anyone else gets a neutral line. -->
          <j:choose>
            <j:when test="${carrierUrl != null}">
              <strong>Batch Control: activation is held by
                <a class="model-link" href="${rootURL}/${carrierUrl}">${carrier.fullDisplayName}</a>,
                which is ${it.carrierState(carrier)}.</strong>
            </j:when>
            <j:otherwise>
              <strong>Batch Control: activation is managed by an item you cannot see.</strong>
            </j:otherwise>
          </j:choose>
          This job is generated by a folder; unattended runs follow that folder's activation,
          and activation or hold requests are made on it.
        </div>
      </j:when>
      <j:when test="${it.activated}">
        <div class="jenkins-alert jenkins-alert-success ${noticeClass}" role="status">
          <strong>Batch Control: this job is activated.</strong>
          Timer and upstream triggers may start it, as far as its own trigger settings allow.
          <j:if test="${it.canRequest}">
            To stop unattended runs, <a href="${formUrl}">request a hold</a>; the hold takes effect
            once it is approved.
          </j:if>
        </div>
      </j:when>
      <j:otherwise>
        <div class="jenkins-alert jenkins-alert-warning ${noticeClass}" role="status">
          <j:choose>
            <j:when test="${it.held}">
              <strong>Batch Control: this job is on hold.</strong>
            </j:when>
            <j:otherwise>
              <strong>Batch Control: this job is not activated.</strong>
            </j:otherwise>
          </j:choose>
          Timer and upstream triggers do not start it until an activation request is approved.
          Changing the job configuration does not change this.
          <j:if test="${it.canRequest}">
            <a href="${formUrl}">Request activation</a>.
          </j:if>
        </div>
      </j:otherwise>
    </j:choose>
    <j:set var="pending" value="${it.pendingRequests}"/>
    <j:if test="${carrier == null and !empty(pending)}">
      <ul class="jenkins-!-margin-top-1 jenkins-!-margin-bottom-1">
        <j:forEach var="r" items="${pending}">
          <li>
            Pending ${it.actionLabel(r.action)} request
            <a href="${rootURL}/batch-control/activations/${r.id}/">${r.id}</a>
            by ${r.requester}
          </li>
        </j:forEach>
      </ul>
    </j:if>
  </j:if>
</j:jelly>
