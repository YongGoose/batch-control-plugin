<?jelly escape-by-default='true'?>
<!-- D-66: the run request form for core's dialog (the job's Request Run entry). Only the form
     is rendered, without the page layout, like core's build-parameters dialog. The permission
     check l:layout permissions="..." makes on the page is made here first: BatchControl/Request
     on the job (JobRequestAction#checkDialogPermission). -->
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:l="/lib/layout">
  <!-- A constant title: a response header cannot carry every job name (non-Latin text); the
       form names the job. -->
  <st:setHeader name="X-Dialog-Title" value="Request Run"/>
  <!-- Inside l:ajax: core lets a view be dispatched only once l:ajax (or l:layout) has marked it
       as a page, so nothing may be written before it. -->
  <l:ajax>
    ${it.checkDialogPermission()}
    <j:set var="bcDialog" value="true"/>
    <st:include page="_form.jelly"/>
  </l:ajax>
</j:jelly>
