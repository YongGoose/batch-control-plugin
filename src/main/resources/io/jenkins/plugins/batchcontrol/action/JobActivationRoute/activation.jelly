<?jelly escape-by-default='true'?>
<!-- Serves <item>/batch-control/activation without a trailing slash (the URL the job and folder
     pages and the tests use): Stapler would otherwise redirect the getter's index to
     "activation/". Renders the same page as JobActivationForm/index.jelly, whose links are
     absolute. The item is a job or a computed folder (D-46c).

     e2e-03 DEF-06: JobActivationRoute is no model object, so the breadcrumb bar ends at the item.
     activationCrumb asks the included page to append its own "Activation" crumb. It is not set on
     the trailing-slash URL, where JobActivationForm is itself an ancestor and already supplies
     that crumb. -->
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler">
  <j:set var="activationCrumb" value="${true}"/>
  <st:include page="index.jelly" it="${it.activation}"/>
</j:jelly>
