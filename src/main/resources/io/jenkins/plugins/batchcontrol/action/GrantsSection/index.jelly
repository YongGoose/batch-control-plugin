<?jelly escape-by-default='true'?>
<!-- e2e-03 DEF-09: a refused new request comes back to this page (GrantsSection#doCreate,
     ui.FormErrors) with each message next to its field and the input kept; links are absolute
     because the refusal is rendered at .../grants/create. DEF-18 (D-33): ended windows are
     listed with a re-request link. -->
<j:jelly xmlns:j="jelly:core" xmlns:l="/lib/layout" xmlns:f="/lib/form"
         xmlns:bc="/io/jenkins/plugins/batchcontrol/tags">
  <l:layout title="Grants" type="one-column" permissions="${it.viewPermissions}">
    <l:main-panel>
      <l:app-bar title="Grants"/>
      <j:set var="base" value="${rootURL}/batch-control/grants/"/>
      <p class="jenkins-description">
        Temporary (just-in-time) permission requests for creating, configuring or deleting jobs,
        the grants currently active and the ones that have ended.
      </p>

      <!-- e2e-04 FD-08: the request form comes first, so the job sidebar entry (prefilled scope)
           and a refused submission (re-rendered at .../grants/create with the message above the
           form) both open with the form and any error in view. The lists follow, 50 rows a page. -->
      <j:if test="${it.canRequest}">
        <h2 id="new-grant-request">New Grant Request</h2>
        <!-- U-01: arriving from a job's "Request Change Permission" entry prefills the scope and
             pre-selects Configure. Both values come from the resolved model object, never from
             the raw query string, and are escaped by the Jelly default like every other value. -->
        <j:set var="errors" value="${it.formErrors}"/>
        <j:set var="renew" value="${it.renewSource}"/>
        <j:if test="${it.prefilled and !errors.present}">
          <p class="jenkins-description">
            <j:choose>
              <j:when test="${renew != null}">
                Prefilled from ended grant ${renew.id} for <strong>${it.prefillScopeFullName}</strong>.
                Check the actions and duration, say why you need it again, and check one or more
                approvers.
              </j:when>
              <j:otherwise>
                Prefilled for <strong>${it.prefillScopeFullName}</strong>. Check the actions you need,
                say why, and check one or more approvers.
              </j:otherwise>
            </j:choose>
          </p>
        </j:if>
        <bc:formError errors="${errors}"/>
        <j:set var="scopeTypeValue" value="${errors.present ? errors.value('scopeType') : it.prefillScopeType}"/>
        <f:form method="post" action="${base}create" name="createGrantRequest">
          <f:entry title="Scope type" help="/plugin/batch-control/help/grant-scope-type.html">
            <div class="jenkins-select">
              <select name="scopeType" class="jenkins-select__input">
                <option value="JOB" selected="${scopeTypeValue == 'JOB' ? 'true' : null}">Job (exact full name)</option>
                <option value="FOLDER" selected="${scopeTypeValue == 'FOLDER' ? 'true' : null}">Folder (the folder and everything below it)</option>
              </select>
            </div>
            <bc:fieldError errors="${errors}" field="scopeType"/>
          </f:entry>
          <f:entry title="Scope full name" help="/plugin/batch-control/help/grant-scope-full-name.html">
            <input type="text" name="scopeFullName" class="jenkins-input" placeholder="team/folder/job"
                   value="${errors.present ? errors.value('scopeFullName') : it.prefillScopeFullName}"/>
            <bc:fieldError errors="${errors}" field="scopeFullName"/>
          </f:entry>
          <f:entry title="Actions" help="/plugin/batch-control/help/grant-actions.html">
            <!-- Posted as repeated "actions" fields (CREATE / CONFIGURE / DELETE), which
                 GrantsSection#doCreate reads with getParameterValues("actions"). -->
            <div class="jenkins-!-margin-bottom-1">
              <f:checkbox name="actions" value="CREATE" id="grant-action-create" title="Create"
                          checked="${errors.present ? errors.checked('actions', 'CREATE') : it.isPrefillAction('CREATE')}"/>
            </div>
            <div class="jenkins-!-margin-bottom-1">
              <f:checkbox name="actions" value="CONFIGURE" id="grant-action-configure" title="Configure"
                          checked="${errors.present ? errors.checked('actions', 'CONFIGURE') : it.isPrefillAction('CONFIGURE')}"/>
            </div>
            <div>
              <f:checkbox name="actions" value="DELETE" id="grant-action-delete" title="Delete"
                          checked="${errors.present ? errors.checked('actions', 'DELETE') : it.isPrefillAction('DELETE')}"/>
            </div>
            <bc:fieldError errors="${errors}" field="actions"/>
          </f:entry>
          <!-- D-40: optional, CREATE only. Length-bounded here and in GrantsSection#doCreate;
               syntax is validated by the service at submission. -->
          <f:entry title="New job name restriction (Create only)"
                   description="Optional. An exact job name, or a regular expression between slashes that must match the whole name."
                   help="/plugin/batch-control/help/grant-create-name-pattern.html">
            <input type="text" name="createNamePattern" class="jenkins-input"
                   placeholder="nightly-report or /report-[0-9]+/"
                   maxlength="${it.createNamePatternMaxLength}"
                   value="${errors.present ? errors.value('createNamePattern') : it.prefillCreateNamePattern}"/>
            <bc:fieldError errors="${errors}" field="createNamePattern"/>
          </f:entry>
          <f:entry title="Duration" help="/plugin/batch-control/help/grant-duration.html">
            <div class="jenkins-select">
              <select name="durationMinutes" class="jenkins-select__input">
                <j:forEach var="d" items="${it.durationOptions}">
                  <j:set var="durationSelected" value="${errors.present ? errors.value('durationMinutes') == d.toString() : it.isPrefillDuration(d)}"/>
                  <option value="${d}" selected="${durationSelected ? 'true' : null}">${it.minutesLabel(d)}</option>
                </j:forEach>
              </select>
            </div>
            <bc:fieldError errors="${errors}" field="durationMinutes"/>
          </f:entry>
          <f:entry title="Custom duration (minutes)"
                   description="Optional. Overrides the preset above when set. Maximum: ${it.maxGrantMinutes} minutes.">
            <input type="number" name="customDurationMinutes" class="jenkins-input"
                   min="1" max="${it.maxGrantMinutes}" step="1" value="${errors.value('customDurationMinutes')}"/>
            <bc:fieldError errors="${errors}" field="customDurationMinutes"/>
          </f:entry>
          <f:entry title="Reason" help="/plugin/batch-control/help/grant-reason.html">
            <f:textarea name="reason" value="${errors.value('reason')}"/>
            <bc:fieldError errors="${errors}" field="reason"/>
          </f:entry>
          <j:choose>
            <j:when test="${empty(it.approverOptions)}">
              <div class="jenkins-alert jenkins-alert-warning">
                No approvers are configured. Ask an administrator to add approvers in the
                Batch Control global configuration before requesting a grant.
              </div>
            </j:when>
            <j:otherwise>
              <!-- D-37: repeated "approvers" fields, one user id per checked box. -->
              <f:entry title="Approvers" description="Any one of the checked approvers may decide."
                       help="/plugin/batch-control/help/approvers.html">
                <j:set var="singleApprover" value="${it.approverOptions.size() == 1}"/>
                <j:forEach var="a" items="${it.approverOptions}" varStatus="s">
                  <div class="jenkins-!-margin-bottom-1">
                    <f:checkbox name="approvers" value="${a}" id="grant-approver-${s.index}"
                                title="${a}" checked="${errors.present ? errors.checked('approvers', a) : singleApprover}"/>
                  </div>
                </j:forEach>
                <bc:fieldError errors="${errors}" field="approvers"/>
              </f:entry>
              <f:bottomButtonBar>
                <f:submit value="Request Grant"/>
              </f:bottomButtonBar>
            </j:otherwise>
          </j:choose>
        </f:form>
      </j:if>

      <h2>Grant Requests</h2>
      <j:choose>
        <j:when test="${it.total == 0}">
          <p>No grant requests.</p>
        </j:when>
        <j:otherwise>
          <table class="jenkins-table">
            <thead>
              <tr>
                <th>ID</th>
                <th>Scope</th>
                <th>Actions</th>
                <th>Duration</th>
                <th>Reason</th>
                <th>Requester</th>
                <th>Approvers</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              <j:forEach var="r" items="${it.pageItems}">
                <tr>
                  <td><a href="${base}${r.id}/">${r.id}</a></td>
                  <td>${r.scope.type}: ${r.scope.fullName}</td>
                  <td>${it.join(r.actions)}</td>
                  <td>${r.durationMinutes} min</td>
                  <td>${r.reason}</td>
                  <td>${r.requester}</td>
                  <td>${it.join(r.approvers)}</td>
                  <td>${it.statusLabel(r)}</td>
                </tr>
              </j:forEach>
            </tbody>
          </table>
          <div class="jenkins-buttons-row" style="margin-top: 1rem;">
            <j:if test="${it.hasPrevious}">
              <a class="jenkins-button" href="${base}?page=${it.page - 1}&amp;activePage=${it.activePage}&amp;pastPage=${it.pastPage}">Newer</a>
            </j:if>
            <span>Page ${it.page} (${it.total} requests)</span>
            <j:if test="${it.hasNext}">
              <a class="jenkins-button" href="${base}?page=${it.page + 1}&amp;activePage=${it.activePage}&amp;pastPage=${it.pastPage}">Older</a>
            </j:if>
          </div>
        </j:otherwise>
      </j:choose>

      <h2>Active Grants</h2>
      <p class="jenkins-description">
        Remaining time is measured when the page is rendered; reload to refresh it.
      </p>
      <j:choose>
        <j:when test="${it.activeTotal == 0}">
          <p>No active grants.</p>
        </j:when>
        <j:otherwise>
          <table class="jenkins-table">
            <thead>
              <tr>
                <th>ID</th>
                <th>User</th>
                <th>Scope</th>
                <th>Actions</th>
                <th>New job names</th>
                <th>Granted</th>
                <th>Expires</th>
                <th>Remaining</th>
                <j:if test="${it.canRevoke}">
                  <th/>
                </j:if>
              </tr>
            </thead>
            <tbody>
              <j:forEach var="g" items="${it.activePageItems}">
                <tr>
                  <td>${g.id}</td>
                  <td>${g.user}</td>
                  <td>${g.scope.type}: ${g.scope.fullName}</td>
                  <td>${it.join(g.actions)}</td>
                  <td><code>${it.createNameLabel(g)}</code></td>
                  <td>${it.format(g.grantedAt)}</td>
                  <td>${it.format(g.expiresAt)}</td>
                  <td>${it.remaining(g.expiresAt)}</td>
                  <j:if test="${it.canRevoke}">
                    <td>
                      <l:confirmationLink class="jenkins-button jenkins-!-destructive-color" destructive="true" href="${base}active/${g.id}/revoke" post="true"
                                          title="Revoke this grant?" okText="Revoke"
                                          message="The user immediately loses the granted permissions. This cannot be undone.">
                        Revoke
                      </l:confirmationLink>
                    </td>
                  </j:if>
                </tr>
              </j:forEach>
            </tbody>
          </table>
          <div class="jenkins-buttons-row" style="margin-top: 1rem;">
            <j:if test="${it.hasActivePrevious}">
              <a class="jenkins-button" href="${base}?activePage=${it.activePage - 1}&amp;page=${it.page}&amp;pastPage=${it.pastPage}">Newer</a>
            </j:if>
            <span>Page ${it.activePage} (${it.activeTotal} active grants)</span>
            <j:if test="${it.hasActiveNext}">
              <a class="jenkins-button" href="${base}?activePage=${it.activePage + 1}&amp;page=${it.page}&amp;pastPage=${it.pastPage}">Older</a>
            </j:if>
          </div>
        </j:otherwise>
      </j:choose>

      <!-- DEF-18 (SPEC item 8, D-33): the history of ended windows, with a re-request link that
           opens the form above prefilled from the ended grant (resolved from the store, the
           caller's own grants only; never echoed from the query string). -->
      <h2>Ended Grants</h2>
      <j:choose>
        <j:when test="${it.pastTotal == 0}">
          <p>No ended grants.</p>
        </j:when>
        <j:otherwise>
          <table class="jenkins-table">
            <thead>
              <tr>
                <th>ID</th>
                <th>User</th>
                <th>Scope</th>
                <th>Actions</th>
                <th>New job names</th>
                <th>Granted</th>
                <th>Ended</th>
                <th>How</th>
                <th/>
              </tr>
            </thead>
            <tbody>
              <j:forEach var="g" items="${it.pastPageItems}">
                <tr>
                  <td>${g.id}</td>
                  <td>${g.user}</td>
                  <td>${g.scope.type}: ${g.scope.fullName}</td>
                  <td>${it.join(g.actions)}</td>
                  <td><code>${it.createNameLabel(g)}</code></td>
                  <td>${it.format(g.grantedAt)}</td>
                  <td>${it.format(it.endedAt(g))}</td>
                  <td>${it.endedLabel(g)}</td>
                  <td>
                    <j:if test="${it.isCanRenew(g)}">
                      <a href="${base}?from=${g.id}#new-grant-request">Request again</a>
                    </j:if>
                  </td>
                </tr>
              </j:forEach>
            </tbody>
          </table>
          <div class="jenkins-buttons-row" style="margin-top: 1rem;">
            <j:if test="${it.hasPastPrevious}">
              <a class="jenkins-button" href="${base}?pastPage=${it.pastPage - 1}&amp;page=${it.page}&amp;activePage=${it.activePage}">Newer</a>
            </j:if>
            <span>Page ${it.pastPage} (${it.pastTotal} ended grants)</span>
            <j:if test="${it.hasPastNext}">
              <a class="jenkins-button" href="${base}?pastPage=${it.pastPage + 1}&amp;page=${it.page}&amp;activePage=${it.activePage}">Older</a>
            </j:if>
          </div>
        </j:otherwise>
      </j:choose>

    </l:main-panel>
  </l:layout>
</j:jelly>
