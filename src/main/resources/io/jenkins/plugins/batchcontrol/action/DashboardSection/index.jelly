<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:l="/lib/layout">
  <l:layout title="Run Dashboard" type="one-column" permissions="${it.viewPermissions}">
    <l:main-panel>
      <l:app-bar title="Run Dashboard"/>
      <p class="jenkins-description">
        Every build of every job with cause, user, parameters, result and duration.
        Showing the last ${it.days} day(s), newest first. Secret parameter values are stored masked.
      </p>

      <!-- Window selector: a plain GET form; changing the window never changes state. -->
      <form method="get" action="." class="jenkins-buttons-row" style="margin-bottom: 1rem;">
        <label for="days">Days:</label>
        <input type="number" id="days" name="days" min="1" max="365" value="${it.days}" class="jenkins-input" style="width: 6rem;"/>
        <button type="submit" class="jenkins-button">Show</button>
      </form>

      <j:set var="requestLinks" value="${it.links.requests}"/>
      <j:choose>
        <j:when test="${it.total == 0}">
          <p>No runs recorded in the last ${it.days} day(s).</p>
        </j:when>
        <j:otherwise>
          <table class="jenkins-table">
            <thead>
              <tr>
                <th>Run</th>
                <th>Job</th>
                <th>Cause</th>
                <th>User</th>
                <th>Parameters</th>
                <th>Result</th>
                <th>Started</th>
                <th>Duration</th>
                <th>Aborted by</th>
                <th>Request</th>
              </tr>
            </thead>
            <tbody>
              <j:forEach var="r" items="${it.pageItems}">
                <tr>
                  <td><a href="${rootURL}/${it.runUrl(r)}">#${r.number}</a></td>
                  <td>${r.jobFullName}</td>
                  <td>${r.causeType}</td>
                  <td>${r.user}</td>
                  <td style="white-space: pre-wrap;">${it.parameters(r.parameters)}</td>
                  <td>${r.result}</td>
                  <td>${it.format(r.startedAt)}</td>
                  <td>${it.duration(r.durationMs)}</td>
                  <td>${r.abortedBy}</td>
                  <td>
                    <!-- Linked only for a user who may open the Run Requests screen (SPEC item 2). -->
                    <j:choose>
                      <j:when test="${r.runRequestId != null and requestLinks}">
                        <a href="${rootURL}/batch-control/requests/${r.runRequestId}/">${r.runRequestId}</a>
                      </j:when>
                      <j:otherwise>${r.runRequestId}</j:otherwise>
                    </j:choose>
                  </td>
                </tr>
              </j:forEach>
            </tbody>
          </table>
          <div class="jenkins-buttons-row" style="margin-top: 1rem;">
            <j:if test="${it.hasPrevious}">
              <a class="jenkins-button" href="?days=${it.days}&amp;page=${it.page - 1}">Newer</a>
            </j:if>
            <span>Page ${it.page} (${it.total} runs in the last ${it.days} day(s))</span>
            <j:if test="${it.hasNext}">
              <a class="jenkins-button" href="?days=${it.days}&amp;page=${it.page + 1}">Older</a>
            </j:if>
          </div>
        </j:otherwise>
      </j:choose>
    </l:main-panel>
  </l:layout>
</j:jelly>
