<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:l="/lib/layout">
  <l:layout title="Change Records">
    <l:side-panel>
      <l:tasks>
        <l:task href="${rootURL}/batch-control/" icon="symbol-arrow-left" title="Back to Batch Control"/>
      </l:tasks>
    </l:side-panel>
    <l:main-panel>
      <h1>Change Records</h1>
      <p class="jenkins-description">
        Automatic audit trail of job creation, configuration, deletion, rename and move events
        (SPEC item 9). Records are read-only.
      </p>

      <!-- Month selector: a plain GET form; changing the month never changes state. -->
      <form method="get" action="." style="margin-bottom: 1rem; display: flex; gap: 0.5rem; align-items: center;">
        <a class="jenkins-button" href="?month=${it.previousMonth}">&#171; ${it.previousMonth}</a>
        <input type="month" name="month" value="${it.monthValue}" class="jenkins-input" style="width: auto;"/>
        <button type="submit" class="jenkins-button">Show</button>
        <j:if test="${it.hasNextMonth}">
          <a class="jenkins-button" href="?month=${it.nextMonth}">${it.nextMonth} &#187;</a>
        </j:if>
      </form>

      <j:choose>
        <j:when test="${it.total == 0}">
          <p>No change records in ${it.monthValue}.</p>
        </j:when>
        <j:otherwise>
          <table class="jenkins-table">
            <thead>
              <tr>
                <th>Type</th>
                <th>Target</th>
                <th>User</th>
                <th>At</th>
                <th>Grant</th>
                <th>Detail</th>
              </tr>
            </thead>
            <tbody>
              <j:forEach var="r" items="${it.pageItems}">
                <tr>
                  <td>${r.type}</td>
                  <td>${r.target}</td>
                  <td>${r.user}</td>
                  <td>${it.format(r.at)}</td>
                  <td>
                    <j:choose>
                      <j:when test="${r.grantId != null}">
                        <a href="${rootURL}/batch-control/grants/${r.grantId}/">${r.grantId}</a>
                      </j:when>
                      <j:otherwise>
                        <span class="jenkins-label jenkins-label--tertiary" title="This change was made without an active grant.">no grant</span>
                      </j:otherwise>
                    </j:choose>
                  </td>
                  <td>
                    ${r.detail}
                    <j:if test="${r.diff != null}">
                      <!-- Escaped by default: diffs contain XML from config.xml files. -->
                      <details>
                        <summary>Show diff</summary>
                        <pre style="overflow-x: auto;">${r.diff}</pre>
                      </details>
                    </j:if>
                  </td>
                </tr>
              </j:forEach>
            </tbody>
          </table>
          <div style="margin-top: 1rem; display: flex; gap: 0.5rem; align-items: center;">
            <j:if test="${it.hasPrevious}">
              <a class="jenkins-button" href="?month=${it.monthValue}&amp;page=${it.page - 1}">Newer</a>
            </j:if>
            <span>Page ${it.page} (${it.total} records in ${it.monthValue})</span>
            <j:if test="${it.hasNext}">
              <a class="jenkins-button" href="?month=${it.monthValue}&amp;page=${it.page + 1}">Older</a>
            </j:if>
          </div>
        </j:otherwise>
      </j:choose>
    </l:main-panel>
  </l:layout>
</j:jelly>
