<?jelly escape-by-default='true'?>
<j:jelly xmlns:bc="/io/jenkins/plugins/batchcontrol/tags" xmlns:j="jelly:core" xmlns:l="/lib/layout" xmlns:st="jelly:stapler">
  <l:layout title="Change Records" type="one-column" permissions="${it.viewPermissions}">
    <l:main-panel>
      <l:app-bar title="Change Records"/>
      <bc:tabs active="changes"/>
      <p class="jenkins-description">
        Automatic audit trail of job creation, configuration, deletion, rename and move events.
        Records are read-only.
      </p>

      <!-- Month selector: a plain GET form; changing the month never changes state. no-json and
           the getForm adjunct keep core's crumb and json fields out of the URL (e2e-12 DEF-07). -->
      <st:adjunct includes="io.jenkins.plugins.batchcontrol.ui.getForm"/>
      <form method="get" action="." class="jenkins-buttons-row no-json" data-batch-control-get-form="true" style="margin-bottom: 1rem;">
        <a class="jenkins-button" href="?month=${it.previousMonth}">&#171; ${it.previousMonth}</a>
        <input type="month" name="month" value="${it.monthValue}" class="jenkins-input" style="width: auto;"/>
        <button type="submit" class="jenkins-button">Show</button>
        <j:if test="${it.hasNextMonth}">
          <a class="jenkins-button" href="?month=${it.nextMonth}">${it.nextMonth} &#187;</a>
        </j:if>
      </form>

      <j:set var="links" value="${it.links}"/>
      <j:set var="grantLinks" value="${links.grants}"/>
      <!-- security-11 N-02: lines over 1 MiB are skipped on every read path, CSV included. -->
      <j:if test="${it.oversized > 0}">
        <div class="jenkins-alert jenkins-alert-warning" style="margin-bottom: 1rem;">
          ${it.oversized} over-long record(s) (larger than 1 MiB) were skipped while reading this
          period and are not listed here. The CSV export skips them too; the controller log names
          the file that holds them.
        </div>
      </j:if>
      <!-- #13: the read stops at a record cap; the count is then a lower bound. -->
      <j:if test="${it.truncated}">
        <div class="jenkins-alert jenkins-alert-warning" style="margin-bottom: 1rem;">
          This period holds more records than one screen can scan (the newest 50,000 were read),
          so this list and its count are incomplete. The CSV export is complete for the period:
          <a href="${it.csvUrl}">download it</a>.
        </div>
      </j:if>
      <j:choose>
        <j:when test="${it.total == 0}">
          <p>No change records in ${it.monthValue}.</p>
        </j:when>
        <j:otherwise>
          <table class="jenkins-table jenkins-table--small jenkins-!-margin-bottom-0">
            <thead>
              <tr>
                <th>Type</th>
                <th>Target</th>
                <th>User</th>
                <th>At</th>
                <th>Grant</th>
                <th>Detail</th>
              </tr>
            </thead>
            <tbody>
              <j:forEach var="r" items="${it.pageItems}">
                <tr>
                  <td>${r.type}</td>
                  <td>${r.target}</td>
                  <td>${r.user}</td>
                  <td>${it.format(r.at)}</td>
                  <td>
                    <j:choose>
                      <!-- Linked only for a user who may open the Grants screen (SPEC item 2). -->
                      <j:when test="${r.grantId != null and grantLinks and links.grant(r.grantId)}">
                        <bc:idLink href="${rootURL}/batch-control/grants/${r.grantId}/" value="${r.grantId}"/>
                      </j:when>
                      <j:when test="${r.grantId != null}">${r.grantId}</j:when>
                      <j:otherwise>
                        <span class="jenkins-label jenkins-label--tertiary" title="This change was made without an active grant.">no grant</span>
                      </j:otherwise>
                    </j:choose>
                  </td>
                  <td>
                    ${r.detail}
                    <j:if test="${r.diff != null}">
                      <!-- U-07: the size of the change is always visible, so no click is needed to
                           learn what a row is about; the body stays collapsed because a page holds
                           up to 50 records and a config.xml diff runs to hundreds of lines.
                           Escaped by default: diffs contain XML from config.xml files. -->
                      <j:set var="summary" value="${it.diffSummary(r.diff)}"/>
                      <details>
                        <summary>
                          <j:choose>
                            <j:when test="${summary != ''}">Diff (${summary})</j:when>
                            <j:otherwise>Diff</j:otherwise>
                          </j:choose>
                        </summary>
                        <pre style="overflow-x: auto;">${r.diff}</pre>
                      </details>
                    </j:if>
                  </td>
                </tr>
              </j:forEach>
            </tbody>
          </table>
          <div class="jenkins-buttons-row jenkins-!-margin-top-1 jenkins-!-margin-bottom-3" role="navigation" aria-label="Pages of change records">
            <j:if test="${it.hasPrevious}">
              <a class="jenkins-button" href="?month=${it.monthValue}&amp;page=${it.page - 1}">Newer</a>
            </j:if>
            <span>Page ${it.page} (${it.total} ${it.total == 1 ? 'record' : 'records'} in ${it.monthValue})</span>
            <j:if test="${it.hasNext}">
              <a class="jenkins-button" href="?month=${it.monthValue}&amp;page=${it.page + 1}">Older</a>
            </j:if>
          </div>
        </j:otherwise>
      </j:choose>
    </l:main-panel>
  </l:layout>
</j:jelly>
