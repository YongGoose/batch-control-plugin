<?jelly escape-by-default='true'?>
<j:jelly xmlns:bc="/io/jenkins/plugins/batchcontrol/tags" xmlns:j="jelly:core" xmlns:l="/lib/layout">
  <l:layout title="Incidents" type="one-column" permissions="${it.viewPermissions}">
    <l:main-panel>
      <l:app-bar title="Incidents"/>
      <bc:tabs active="incidents"/>
      <p class="jenkins-description">
        Failed and unstable builds are registered automatically as incidents.
        Open an incident to acknowledge, comment or resolve it; a user who may submit run requests for its job can also request a rerun there.
      </p>

      <!-- Month selector: a plain GET form; changing the month never changes state. -->
      <form method="get" action="." class="jenkins-buttons-row" style="margin-bottom: 1rem;">
        <a class="jenkins-button" href="?month=${it.previousMonth}">&#171; ${it.previousMonth}</a>
        <input type="month" name="month" value="${it.monthValue}" class="jenkins-input" style="width: auto;"/>
        <button type="submit" class="jenkins-button">Show</button>
        <j:if test="${it.hasNextMonth}">
          <a class="jenkins-button" href="?month=${it.nextMonth}">${it.nextMonth} &#187;</a>
        </j:if>
      </form>

      <!-- security-11 N-02: lines over 1 MiB are skipped on every read path, CSV included. -->
      <j:if test="${it.oversized > 0}">
        <div class="jenkins-alert jenkins-alert-warning" style="margin-bottom: 1rem;">
          ${it.oversized} over-long record(s) (larger than 1 MiB) were skipped while reading this
          period and are not listed here. The CSV export skips them too; the controller log names
          the file that holds them.
        </div>
      </j:if>
      <!-- #13: the read stops at a record cap; the count is then a lower bound. -->
      <j:if test="${it.truncated}">
        <div class="jenkins-alert jenkins-alert-warning" style="margin-bottom: 1rem;">
          This period holds more records than one screen can scan (the newest 50,000 were read),
          so this list and its count are incomplete. The CSV export is complete for the period:
          <a href="${it.csvUrl}">download it</a>.
        </div>
      </j:if>
      <j:choose>
        <j:when test="${it.total == 0}">
          <p>No incidents in ${it.monthValue}.</p>
        </j:when>
        <j:otherwise>
          <table class="jenkins-table jenkins-table--small jenkins-!-margin-bottom-0">
            <thead>
              <tr>
                <th>Incident</th>
                <th>Run</th>
                <th>Job</th>
                <th>Result</th>
                <th>Status</th>
                <th>Created</th>
              </tr>
            </thead>
            <tbody>
              <j:forEach var="i" items="${it.pageItems}">
                <tr>
                  <td><a href="${i.id}/">${i.id}</a></td>
                  <td>
                    <j:choose>
                      <j:when test="${it.runUrl(i) != null}">
                        <a href="${rootURL}/${it.runUrl(i)}">${i.runId}</a>
                      </j:when>
                      <j:otherwise>${i.runId}</j:otherwise>
                    </j:choose>
                  </td>
                  <td>${i.jobFullName}</td>
                  <td>${i.result}</td>
                  <td>${i.status}</td>
                  <td>${it.format(it.createdAt(i))}</td>
                </tr>
              </j:forEach>
            </tbody>
          </table>
          <div class="jenkins-buttons-row jenkins-!-margin-top-1 jenkins-!-margin-bottom-3" role="navigation" aria-label="Pages of incidents">
            <j:if test="${it.hasPrevious}">
              <a class="jenkins-button" href="?month=${it.monthValue}&amp;page=${it.page - 1}">Newer</a>
            </j:if>
            <span>Page ${it.page} (${it.total} ${it.total == 1 ? 'incident' : 'incidents'} in ${it.monthValue})</span>
            <j:if test="${it.hasNext}">
              <a class="jenkins-button" href="?month=${it.monthValue}&amp;page=${it.page + 1}">Older</a>
            </j:if>
          </div>
        </j:otherwise>
      </j:choose>
    </l:main-panel>
  </l:layout>
</j:jelly>
