<?jelly escape-by-default='true'?>
<!-- SPEC item 6a: the activation approval inbox and the activation requests the viewer may see
     (P-09: requester, designated approvers, Manage). A job name links to the job only for a
     viewer who holds Item/Read on it. D-38c: open to every user admitted to the root page. -->
<j:jelly xmlns:bc="/io/jenkins/plugins/batchcontrol/tags" xmlns:j="jelly:core" xmlns:l="/lib/layout">
  <l:layout title="Activations" type="one-column" permissions="${it.viewPermissions}">
    <l:main-panel>
      <l:app-bar title="Activations"/>
      <bc:tabs active="activations"/>
      <p class="jenkins-description">
        Activation requests put a job into service for timer and upstream triggers; hold requests
        take it out of service. Both take effect only once a designated approver approves them.
      </p>

      <j:set var="inbox" value="${it.awaitingDecision}"/>
      <j:if test="${!empty(inbox)}">
        <h2>Awaiting Your Decision</h2>
        <table class="jenkins-table jenkins-table--small">
          <thead>
            <tr>
              <th>ID</th>
              <th>Action</th>
              <th>Job or folder</th>
              <th>Requester</th>
              <th>Created</th>
            </tr>
          </thead>
          <tbody>
            <j:forEach var="r" items="${inbox}">
              <tr>
                <td><a href="${r.id}/">${r.id}</a></td>
                <td><strong>${it.actionLabel(r.action)}</strong></td>
                <td>${r.jobFullName}</td>
                <td>${r.requester}</td>
                <td>${it.format(r.createdAt)}</td>
              </tr>
            </j:forEach>
          </tbody>
        </table>
      </j:if>

      <h2>Activation Requests</h2>
      <j:choose>
        <j:when test="${it.total == 0}">
          <!-- D-38c (backlog #87): the section opens for everyone admitted to the root, so the
               empty state says which requests are listed and where one is filed. -->
          <div class="jenkins-alert jenkins-alert-info" role="status" data-batch-control-empty="activations">
            No activation requests you may see. This list shows the activation and hold requests
            you filed and those you are a designated approver of (all of them for Batch
            Control/Manage holders). To file one, open the job: its Batch Control notice offers
            <strong>Request activation</strong> or <strong>request a hold</strong>.
          </div>
        </j:when>
        <j:otherwise>
          <table class="jenkins-table jenkins-table--small jenkins-!-margin-bottom-0">
            <thead>
              <tr>
                <th>ID</th>
                <th>Action</th>
                <th>Job or folder</th>
                <th>Requester</th>
                <th>Approvers</th>
                <th>Status</th>
                <th>Created</th>
              </tr>
            </thead>
            <tbody>
              <j:forEach var="r" items="${it.pageItems}">
                <tr>
                  <td><a href="${r.id}/">${r.id}</a></td>
                  <td><strong>${it.actionLabel(r.action)}</strong></td>
                  <td>
                    <j:set var="jobUrl" value="${it.jobUrl(r)}"/>
                    <j:choose>
                      <j:when test="${jobUrl != null}"><a class="model-link" href="${rootURL}/${jobUrl}">${r.jobFullName}</a></j:when>
                      <j:otherwise>${r.jobFullName}</j:otherwise>
                    </j:choose>
                  </td>
                  <td>${r.requester}</td>
                  <td>${it.join(r.approvers)}</td>
                  <td>${r.status}</td>
                  <td>${it.format(r.createdAt)}</td>
                </tr>
              </j:forEach>
            </tbody>
          </table>
          <div class="jenkins-buttons-row jenkins-!-margin-top-1 jenkins-!-margin-bottom-3" role="navigation" aria-label="Pages of activation requests">
            <j:if test="${it.hasPrevious}">
              <a class="jenkins-button" href="?page=${it.page - 1}">Newer</a>
            </j:if>
            <span>Page ${it.page} (${it.total} ${it.total == 1 ? 'request' : 'requests'})</span>
            <j:if test="${it.hasNext}">
              <a class="jenkins-button" href="?page=${it.page + 1}">Older</a>
            </j:if>
          </div>
        </j:otherwise>
      </j:choose>
    </l:main-panel>
  </l:layout>
</j:jelly>
