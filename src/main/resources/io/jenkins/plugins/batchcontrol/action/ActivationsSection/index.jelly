<?jelly escape-by-default='true'?>
<!-- SPEC item 6a, D-66 (R4-8): the activation and hold requests the viewer may see (P-09:
     requester, designated approvers, Manage) in the layout shared with the Grants and Run
     Requests screens: pending (those awaiting the viewer's decision marked), active (the request
     in effect for its job) and ended, each row linking to its detail page. A job name links to
     the job only for a viewer who holds Item/Read on it. D-38c: open to every user admitted to
     the root page. -->
<j:jelly xmlns:bc="/io/jenkins/plugins/batchcontrol/tags" xmlns:j="jelly:core" xmlns:l="/lib/layout">
  <l:layout title="Activations" type="one-column" permissions="${it.viewPermissions}">
    <l:main-panel>
      <l:app-bar title="Activations"/>
      <bc:tabs active="activations"/>
      <p class="jenkins-description">
        Activation requests put a job into service for timer and upstream triggers; hold requests
        take it out of service. Both take effect only once a designated approver approves them.
      </p>

      <j:choose>
        <j:when test="${it.total == 0}">
          <!-- D-38c (backlog #87): the section opens for everyone admitted to the root, so the
               empty state says which requests are listed and where one is filed. -->
          <div class="jenkins-alert jenkins-alert-info" role="status" data-batch-control-empty="activations">
            No activation requests you may see. This list shows the activation and hold requests
            you filed and those you are a designated approver of (all of them for Batch
            Control/Manage holders). To file one, open the job: its Batch Control notice offers
            <strong>Request activation</strong> or <strong>request a hold</strong>.
          </div>
        </j:when>
        <j:otherwise>
          <h2>Pending Requests</h2>
          <j:choose>
            <j:when test="${it.pendingTotal == 0}">
              <p>No pending requests.</p>
            </j:when>
            <j:otherwise>
              <table class="jenkins-table jenkins-table--small jenkins-!-margin-bottom-0" data-batch-control-list="pending">
                <thead>
                  <tr><th>ID</th><th>Action</th><th>Job or folder</th><th>Requester</th><th>Approvers</th><th>Created</th></tr>
                </thead>
                <tbody>
                  <j:forEach var="r" items="${it.pendingItems}">
                    <tr>
                      <td style="white-space: nowrap;">
                        <a href="${r.id}/">${r.id}</a>
                        <j:if test="${it.isAwaitingMyDecision(r)}">
                          <div><small data-batch-control-awaiting="true">Awaiting your decision</small></div>
                        </j:if>
                      </td>
                      <td><strong>${it.actionLabel(r.action)}</strong></td>
                      <td>
                        <j:set var="jobUrl" value="${it.jobUrl(r)}"/>
                        <j:choose>
                          <j:when test="${jobUrl != null}"><a class="model-link" href="${rootURL}/${jobUrl}">${r.jobFullName}</a></j:when>
                          <j:otherwise>${r.jobFullName}</j:otherwise>
                        </j:choose>
                      </td>
                      <td>${r.requester}</td>
                      <td>${it.join(r.approvers)}</td>
                      <td>${it.format(r.createdAt)}</td>
                    </tr>
                  </j:forEach>
                </tbody>
              </table>
              <bc:pager param="pendingPage" page="${it.pendingPage}" total="${it.pendingTotal}"
                        hasPrevious="${it.hasPendingPrevious}" hasNext="${it.hasPendingNext}" label="pending requests" singular="request" plural="requests"/>
            </j:otherwise>
          </j:choose>

          <h2 class="jenkins-!-margin-top-3">Active</h2>
          <j:choose>
            <j:when test="${it.activeTotal == 0}">
              <p>No approved request is in effect.</p>
            </j:when>
            <j:otherwise>
              <table class="jenkins-table jenkins-table--small jenkins-!-margin-bottom-0" data-batch-control-list="active">
                <thead>
                  <tr><th>ID</th><th>Action</th><th>Job or folder</th><th>Requester</th><th>Approved by</th><th>Approved</th></tr>
                </thead>
                <tbody>
                  <j:forEach var="r" items="${it.activeItems}">
                    <tr>
                      <td><a href="${r.id}/">${r.id}</a></td>
                      <td><strong>${it.actionLabel(r.action)}</strong></td>
                      <td>
                        <j:set var="jobUrl" value="${it.jobUrl(r)}"/>
                        <j:choose>
                          <j:when test="${jobUrl != null}"><a class="model-link" href="${rootURL}/${jobUrl}">${r.jobFullName}</a></j:when>
                          <j:otherwise>${r.jobFullName}</j:otherwise>
                        </j:choose>
                      </td>
                      <td>${r.requester}</td>
                      <td>${r.decidedBy}</td>
                      <td>${it.format(r.decidedAt)}</td>
                    </tr>
                  </j:forEach>
                </tbody>
              </table>
              <bc:pager param="activePage" page="${it.activePage}" total="${it.activeTotal}"
                        hasPrevious="${it.hasActivePrevious}" hasNext="${it.hasActiveNext}" label="requests in effect" singular="request" plural="requests"/>
            </j:otherwise>
          </j:choose>

          <h2 class="jenkins-!-margin-top-3">Ended</h2>
          <j:choose>
            <j:when test="${it.endedTotal == 0}">
              <p>No ended requests.</p>
            </j:when>
            <j:otherwise>
              <table class="jenkins-table jenkins-table--small jenkins-!-margin-bottom-0" data-batch-control-list="ended">
                <thead>
                  <tr><th>ID</th><th>Action</th><th>Job or folder</th><th>Requester</th><th>Approvers</th><th>Status</th><th>Created</th></tr>
                </thead>
                <tbody>
                  <j:forEach var="r" items="${it.endedItems}">
                    <tr>
                      <td><a href="${r.id}/">${r.id}</a></td>
                      <td><strong>${it.actionLabel(r.action)}</strong></td>
                      <td>
                        <j:set var="jobUrl" value="${it.jobUrl(r)}"/>
                        <j:choose>
                          <j:when test="${jobUrl != null}"><a class="model-link" href="${rootURL}/${jobUrl}">${r.jobFullName}</a></j:when>
                          <j:otherwise>${r.jobFullName}</j:otherwise>
                        </j:choose>
                      </td>
                      <td>${r.requester}</td>
                      <td>${it.join(r.approvers)}</td>
                      <td data-batch-control-status="${r.status}">${it.endedLabel(r)}</td>
                      <td>${it.format(r.createdAt)}</td>
                    </tr>
                  </j:forEach>
                </tbody>
              </table>
              <bc:pager param="endedPage" page="${it.endedPage}" total="${it.endedTotal}"
                        hasPrevious="${it.hasEndedPrevious}" hasNext="${it.hasEndedNext}" label="ended requests" singular="request" plural="requests"/>
            </j:otherwise>
          </j:choose>
        </j:otherwise>
      </j:choose>
    </l:main-panel>
  </l:layout>
</j:jelly>
