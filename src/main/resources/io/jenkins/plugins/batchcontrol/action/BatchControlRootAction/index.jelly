<?jelly escape-by-default='true'?>
<!-- The Batch Control overview at /batch-control/. Hosting review 2026-10-02 (PR6): the sections
     are tabs (bc:tabs) instead of a side panel, the same entries as the breadcrumb dropdown
     (BatchControlRootAction#doContextMenu); each is shown only to a user who may open it (SPEC
     item 2). The overview lists the open items the viewer can act on as text with the tab
     badges' counts; no duplicate navigation buttons. -->
<j:jelly xmlns:j="jelly:core" xmlns:l="/lib/layout" xmlns:bc="/io/jenkins/plugins/batchcontrol/tags">
  <l:layout title="Batch Control" type="one-column" permissions="${it.viewPermissions}">
    <j:set var="links" value="${it.links}"/>
    <l:main-panel>
      <l:app-bar title="Batch Control">
        <!-- e2e-03 DEF-10: the configuration page for BatchControl/Manage holders (shown only to
             them, and only while the page exists). It lives outside /batch-control/, so it is an
             app-bar control rather than a tab. e2e-06 UX-10: through Manage Jenkins for whoever
             may open it, so the breadcrumb reads Manage Jenkins > Batch Control; the root URL for
             a BatchControl/Manage holder without Overall/Manage, who cannot reach /manage/. -->
        <j:set var="configurationLink" value="${it.configurationLink}"/>
        <j:if test="${configurationLink != null}">
          <a class="jenkins-button" href="${rootURL}/${app.hasPermission(app.MANAGE) ? 'manage/' : ''}${configurationLink.urlName}/">
            <l:icon src="symbol-settings-outline plugin-ionicons-api"/>
            Configuration
          </a>
        </j:if>
      </l:app-bar>
      <bc:tabs active="overview"/>
      <p class="jenkins-description">
        Run approval and audit history for jobs under batch control. Use the tabs to open a screen.
      </p>
      <!-- Hosting review item: open run and grant requests are announced like activations. The
           counts are the tab badges (ui.SectionTabs): requests awaiting the viewer's decision, or
           else the viewer's own pending requests. -->
      <j:forEach var="tab" items="${it.tabs}">
        <j:if test="${tab.badge != null}">
          <div class="jenkins-alert jenkins-alert-${tab.badge.severity}" data-batch-control-open="${tab.id}">
            ${tab.badge.tooltip}: <a href="${rootURL}/batch-control/${tab.urlName}">${tab.displayName}</a>
          </div>
        </j:if>
      </j:forEach>
      <j:if test="${!links.requests and !links.grants and !links.history}">
        <p>
          None of the Batch Control screens is available to you right now. Grant requests can
          only be made while change control is enabled.
        </p>
      </j:if>
    </l:main-panel>
  </l:layout>
</j:jelly>
