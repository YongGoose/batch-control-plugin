<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:l="/lib/layout">
  <l:layout title="Batch Control" permissions="${it.viewPermissions}">
    <j:set var="links" value="${it.links}"/>
    <l:side-panel>
      <!-- Each entry is shown only to a user who may open it (SPEC item 2): the predicates are the
           same permission sets the section gates check. The Grants entry also needs change
           control on, because that subtree closes while the switch is off. -->
      <l:tasks>
        <j:if test="${links.requests}">
          <l:task href="${rootURL}/batch-control/requests/" icon="symbol-list-outline plugin-ionicons-api" title="Run Requests"/>
        </j:if>
        <j:if test="${links.activations}">
          <l:task href="${rootURL}/batch-control/activations/" icon="symbol-power-outline plugin-ionicons-api" title="Activations"/>
        </j:if>
        <j:if test="${links.grants}">
          <l:task href="${rootURL}/batch-control/grants/" icon="symbol-key-outline plugin-ionicons-api" title="Grants"/>
        </j:if>
        <j:if test="${links.history}">
          <l:task href="${rootURL}/batch-control/changes/" icon="symbol-document-text-outline plugin-ionicons-api" title="Change Records"/>
          <l:task href="${rootURL}/batch-control/dashboard/" icon="symbol-speedometer-outline plugin-ionicons-api" title="Dashboard"/>
          <l:task href="${rootURL}/batch-control/incidents/" icon="symbol-warning-outline plugin-ionicons-api" title="Incidents"/>
          <l:task href="${rootURL}/batch-control/history/" icon="symbol-search-outline plugin-ionicons-api" title="History"/>
        </j:if>
      </l:tasks>
    </l:side-panel>
    <l:main-panel>
      <l:app-bar title="Batch Control"/>
      <p class="jenkins-description">
        Run approval and audit history for jobs under batch control. Use the side panel to open
        a screen.
      </p>
      <j:if test="${links.activations}">
        <j:set var="pendingActivations" value="${it.pendingActivationCount}"/>
        <j:if test="${pendingActivations > 0}">
          <div class="jenkins-alert jenkins-alert-info">
            ${pendingActivations} activation or hold request(s) are awaiting your decision.
            <a href="${rootURL}/batch-control/activations/">Open Activations</a>
          </div>
        </j:if>
      </j:if>
      <j:if test="${!links.requests and !links.grants and !links.history}">
        <p>
          None of the Batch Control screens is available to you right now. Grant requests can
          only be made while change control is enabled.
        </p>
      </j:if>
    </l:main-panel>
  </l:layout>
</j:jelly>
