<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:l="/lib/layout">
  <l:layout title="Batch Control">
    <l:side-panel>
      <l:tasks>
        <l:task href="${rootURL}/batch-control/requests/" icon="symbol-list" title="Run Requests"/>
        <!-- P-15: the Grants subtree closes while change control is off, so it is not offered
             either. The audit screens below stay: the switch governs what windows confer, not
             what history may be read. -->
        <j:if test="${it.grantsAvailable}">
          <l:task href="${rootURL}/batch-control/grants/" icon="symbol-lock-closed" title="Grants"/>
        </j:if>
        <l:task href="${rootURL}/batch-control/changes/" icon="symbol-clock" title="Change Records"/>
        <l:task href="${rootURL}/batch-control/dashboard/" icon="symbol-monitor" title="Dashboard"/>
        <l:task href="${rootURL}/batch-control/incidents/" icon="symbol-warning" title="Incidents"/>
        <l:task href="${rootURL}/batch-control/history/" icon="symbol-search" title="History"/>
      </l:tasks>
    </l:side-panel>
    <l:main-panel>
      <h1>Batch Control</h1>
      <p class="jenkins-description">
        Run approval and audit history for jobs under batch control.
      </p>
      <p>
        <a class="jenkins-button jenkins-button--primary" href="requests/">Run Requests</a>
        <j:if test="${it.grantsAvailable}">
          <a class="jenkins-button" href="grants/">Grants</a>
        </j:if>
        <a class="jenkins-button" href="changes/">Change Records</a>
        <a class="jenkins-button" href="dashboard/">Dashboard</a>
        <a class="jenkins-button" href="incidents/">Incidents</a>
        <a class="jenkins-button" href="history/">History</a>
      </p>
    </l:main-panel>
  </l:layout>
</j:jelly>
