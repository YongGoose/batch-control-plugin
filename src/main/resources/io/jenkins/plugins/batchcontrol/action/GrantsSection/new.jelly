<?jelly escape-by-default='true'?>
<!-- D-66: the new grant request form as a page, for links that cannot open a dialog (a refusal
     page, a middle click on the sidebar entry, a submission without JavaScript) and the refused
     submission of this page itself. The Grants list no longer starts with the form. -->
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:l="/lib/layout"
         xmlns:bc="/io/jenkins/plugins/batchcontrol/tags">
  <l:layout title="Request Change Permission" type="one-column" permissions="${it.viewPermissions}">
    <l:main-panel>
      <l:app-bar title="Request Change Permission"/>
      <bc:tabs active="grants"/>
      <p class="jenkins-description">
        A temporary (just-in-time) permission window for one job or folder: to configure it,
        to create items directly inside a folder, or to delete a job. It opens when one of the
        approvers you check approves it.
      </p>
      <j:set var="bcDialog" value="false"/>
      <st:include page="_requestForm.jelly"/>
    </l:main-panel>
  </l:layout>
</j:jelly>
