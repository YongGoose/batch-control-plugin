<?jelly escape-by-default='true'?>
<!-- e2e-03 DEF-09: a refused approve, reject, cancel or approver change comes back to this page
     (ui.FormErrors) with the message next to the field or above the form it concerns and the
     input kept. Form targets are absolute because the refusal is rendered at the POST URL.
     D-71: the Scope row shows the one item the request names, with its kind
     (tags/scopeItem.jelly); D-74: once approved, its window's item, which follows the item when
     it is renamed or moved. D-75 (1), S-39-04: the followed name only to a viewer who may read the
     item, otherwise the approved name with a fixed note (GrantRequestItem#getShownScope).
     LIMITATIONS 29: with change control off this page is shown only as the refusal of an
     approval (GrantsSection#getTarget), with the message above the details and no forms. -->
<j:jelly xmlns:j="jelly:core" xmlns:l="/lib/layout" xmlns:f="/lib/form"
         xmlns:bc="/io/jenkins/plugins/batchcontrol/tags">
  <l:layout title="Grant Request ${it.id}" type="one-column" permissions="${it.viewPermissions}">
    <l:main-panel>
      <l:app-bar title="Grant Request ${it.id}"/>
      <bc:tabs active="grants"/>

      <!-- DEF-09: a refusal whose form is no longer shown (the request was decided or cancelled
           meanwhile) is reported here, above the current state. -->
      <j:if test="${!it.canDecide}">
        <bc:formError errors="${it.formErrors('approve')}"/>
        <bc:formError errors="${it.formErrors('reject')}"/>
      </j:if>
      <j:if test="${!it.canChangeApprover}">
        <bc:formError errors="${it.formErrors('changeApprover')}"/>
      </j:if>
      <j:if test="${!it.canCancel}">
        <bc:formError errors="${it.formErrors('cancel')}"/>
      </j:if>

      <table class="jenkins-table jenkins-table--small">
        <tbody>
          <tr>
            <th style="text-align: left; width: 12rem;">Scope</th>
            <td><bc:scopeItem scope="${it.shownScope}" kind="${it.request.itemKind}"/></td>
          </tr>
          <tr><th style="text-align: left;">Actions</th><td>${it.join(it.request.actions)}</td></tr>
          <j:if test="${it.request.createNamePattern != null}">
            <!-- D-40: shown to the approver so the decision covers the name as well. -->
            <tr>
              <th style="text-align: left;">New job name</th>
              <td>
                <code>${it.request.createNamePattern}</code>
                <div class="jenkins-description">
                  Create is allowed only for a new job whose name matches this in full: the exact
                  name, or the regular expression between the slashes.
                </div>
              </td>
            </tr>
          </j:if>
          <tr><th style="text-align: left;">Duration</th><td>${it.request.durationMinutes} ${it.request.durationMinutes == 1 ? 'minute' : 'minutes'}</td></tr>
          <tr><th style="text-align: left;">Status</th><td>${it.request.status}</td></tr>
          <tr><th style="text-align: left;">Requester</th><td>${it.request.requester}</td></tr>
          <tr><th style="text-align: left;">Approvers</th><td>${it.join(it.request.approvers)}</td></tr>
          <tr><th style="text-align: left;">Created</th><td>${it.format(it.request.createdAt)}</td></tr>
          <tr><th style="text-align: left;">Decided</th><td>${it.format(it.request.decidedAt)}</td></tr>
          <j:if test="${it.request.decidedBy != null}">
            <tr><th style="text-align: left;">Decided by</th><td>${it.request.decidedBy}</td></tr>
          </j:if>
          <j:if test="${it.request.decisionComment != null}">
            <!-- e2e-04 FD-05: an expired request shows why it expired, like the run request page. -->
            <tr>
              <th style="text-align: left;">
                <j:choose>
                  <j:when test="${it.request.status.name() == 'EXPIRED'}">Why it expired</j:when>
                  <j:otherwise>Decision comment</j:otherwise>
                </j:choose>
              </th>
              <td style="white-space: pre-wrap;">${it.request.decisionComment}</td>
            </tr>
          </j:if>
        </tbody>
      </table>

      <!-- D-71a (5), security-34 S-34-02: a CONFIGURE request on a folder, multibranch project or
           organization folder confers nothing on the items inside it, but the group's own settings
           still reach them; and its window does not allow renaming the group (D-71c). Stated
           to the designated approvers and the requester
           (GrantRequestItem#isShowGroupConfigureNotice); not shown for a job. Fixed, item-neutral
           text, on one line so that the element's text is exactly the three sentences.
           D-71c (security-36 S-36-04): for a CONFIGURE request on any other item (a job), the same
           audience is told the rename rule alone (GrantRequestItem#isShowNoRenameNotice). -->
      <j:if test="${it.showGroupConfigureNotice}">
        <div class="jenkins-alert jenkins-alert-warning" data-batch-control-notice="group-configure">The settings of this folder, multibranch project or organization folder apply to the items inside it (for example implicitly loaded Pipeline libraries). Reconfiguring a multibranch project or organization folder can create or delete its generated items. A Configure window does not allow renaming it: that needs an administrator, or the user's own Configure permission on it, or own Delete on it plus Create in its parent.</div>
      </j:if>
      <j:if test="${it.showNoRenameNotice}">
        <div class="jenkins-alert jenkins-alert-info" data-batch-control-notice="no-rename">A Configure window does not allow renaming the item: that needs an administrator, or the user's own Configure permission on it, or own Delete on it plus Create in its parent.</div>
      </j:if>

      <!-- R4-12: the window of an approved request, with Revoke for a holder of Batch
           Control/Manage (the rule of the Grants list's Revoke; GrantRequestItem#doRevoke and the
           service re-check). A refused revoke is shown above the window. D-74: an open window
           applies to its item (renamed or moved, it follows; deleted, it ends), so its State is
           the time left. -->
      <j:set var="window" value="${it.grant}"/>
      <j:if test="${window != null}">
        <h2>Permission Window</h2>
        <bc:formError errors="${it.formErrors('revoke')}"/>
        <table class="jenkins-table jenkins-table--small" data-batch-control-window="${it.windowOpen ? 'open' : 'ended'}">
          <tbody>
            <tr><th style="text-align: left; width: 12rem;">Holder</th><td>${window.user}</td></tr>
            <tr><th style="text-align: left;">Granted</th><td>${it.format(window.grantedAt)}</td></tr>
            <tr><th style="text-align: left;">Expires</th><td>${it.format(window.expiresAt)}</td></tr>
            <tr>
              <th style="text-align: left;">State</th>
              <j:choose>
                <j:when test="${it.windowOpen}">
                  <td>Open, ${it.remaining(window.expiresAt)} left</td>
                </j:when>
                <j:otherwise>
                  <td>${it.endedLabelOf(window)}</td>
                </j:otherwise>
              </j:choose>
            </tr>
          </tbody>
        </table>
        <j:if test="${it.canRevoke}">
          <p>
            <l:confirmationLink class="jenkins-button jenkins-!-destructive-color" destructive="true"
                                href="${rootURL}/batch-control/grants/${it.id}/revoke" post="true"
                                title="Revoke this grant?" okText="Revoke"
                                message="The user immediately loses the granted permissions. This cannot be undone.">
              Revoke
            </l:confirmationLink>
          </p>
        </j:if>
      </j:if>

      <h2>Reason</h2>
      <p style="white-space: pre-wrap;">${it.request.reason}</p>

      <j:if test="${!empty(it.request.approverChanges)}">
        <h2>Approver Changes</h2>
        <table class="jenkins-table jenkins-table--small">
          <thead>
            <tr><th>From</th><th>To</th><th>Changed by</th><th>At</th></tr>
          </thead>
          <tbody>
            <j:forEach var="c" items="${it.request.approverChanges}">
              <tr>
                <td>${it.join(c.fromApprovers)}</td>
                <td>${it.join(c.toApprovers)}</td>
                <td>${c.by}</td>
                <td>${it.format(c.at)}</td>
              </tr>
            </j:forEach>
          </tbody>
        </table>
      </j:if>

      <!-- D-50a (SPEC item 2): one fixed, instance-wide warning above the decision form, only to a
           viewer who may decide this request or holds Batch Control/Manage
           (GrantRequestItem#isShowSystemBuildWarning). It names no job and no count. -->
      <j:if test="${it.showSystemBuildWarning}">
        <div class="jenkins-alert jenkins-alert-warning" role="alert">
          <strong>Builds on this instance can run as SYSTEM or as an account that already has
          Configure permission.</strong>
          A holder of a Configure permission window can therefore make a build change a job's
          permissions permanently. A Jenkins administrator can prevent this by setting a global
          default build authorization in Authorize Project that runs every build as an account
          without Configure permission (for example "Run as Specific User" with a dedicated
          low-privilege account). "Run as the user who triggered the build" is only safe together
          with such a fallback, because timer and SCM builds have no triggering user. A strategy
          on a single job is not enough.
        </div>
      </j:if>

      <j:if test="${it.canDecide}">
        <h2>Decision</h2>
        <p class="jenkins-description">
          Approving immediately grants the requester the selected permissions on the requested
          item for the requested duration. The window applies to this item only: it follows the
          item when an administrator (or a user with their own permissions) renames or moves it,
          and ends when the item is deleted.
        </p>
        <j:set var="approveErrors" value="${it.formErrors('approve')}"/>
        <j:set var="rejectErrors" value="${it.formErrors('reject')}"/>
        <bc:formError errors="${approveErrors}"/>
        <f:form method="post" action="${rootURL}/batch-control/grants/${it.id}/approve" name="approve">
          <f:entry title="Comment (optional)">
            <f:textarea name="comment" value="${approveErrors.value('comment')}"/>
            <bc:fieldError errors="${approveErrors}" field="comment"/>
          </f:entry>
          <f:bottomButtonBar>
            <f:submit value="Approve"/>
          </f:bottomButtonBar>
        </f:form>
        <bc:formError errors="${rejectErrors}"/>
        <f:form method="post" action="${rootURL}/batch-control/grants/${it.id}/reject" name="reject">
          <f:entry title="Rejection comment (required)" description="Rejection is final for this request; a rejected request cannot be reopened.">
            <f:textarea name="comment" value="${rejectErrors.value('comment')}"/>
            <bc:fieldError errors="${rejectErrors}" field="comment"/>
          </f:entry>
          <f:bottomButtonBar>
            <button type="submit" class="jenkins-button jenkins-button--destructive">Reject</button>
          </f:bottomButtonBar>
        </f:form>
      </j:if>

      <j:if test="${it.canChangeApprover}">
        <h2>Change Approvers</h2>
        <j:choose>
          <j:when test="${empty(it.approverOptions)}">
            <div class="jenkins-alert jenkins-alert-warning">
              No approvers are configured. Ask an administrator to add approvers in the Batch Control global configuration.
            </div>
          </j:when>
          <j:otherwise>
            <!-- D-26, D-37: starts on the current set; recorded as (previous set, new set). -->
            <j:set var="approverErrors" value="${it.formErrors('changeApprover')}"/>
            <bc:formError errors="${approverErrors}"/>
            <f:form method="post" action="${rootURL}/batch-control/grants/${it.id}/changeApprover" name="changeApprover">
              <f:entry title="Approvers" description="Any one of the checked approvers may decide."
                       help="/plugin/batch-control/help/approvers.html">
                <j:forEach var="a" items="${it.approverOptions}" varStatus="s">
                  <div class="jenkins-!-margin-bottom-1">
                    <f:checkbox name="approvers" value="${a}" id="grant-approver-${s.index}"
                                title="${a}" checked="${approverErrors.present ? approverErrors.checked('approvers', a) : it.isDesignated(a)}"/>
                  </div>
                </j:forEach>
                <bc:fieldError errors="${approverErrors}" field="approvers"/>
              </f:entry>
              <f:bottomButtonBar>
                <f:submit value="Change Approvers"/>
              </f:bottomButtonBar>
            </f:form>
          </j:otherwise>
        </j:choose>
      </j:if>

      <j:if test="${it.canCancel}">
        <h2>Cancel</h2>
        <bc:formError errors="${it.formErrors('cancel')}"/>
        <p>
          <l:confirmationLink class="jenkins-button jenkins-!-destructive-color" destructive="true" href="${rootURL}/batch-control/grants/${it.id}/cancel" post="true" okText="Cancel request" title="Cancel this grant request?"
                              message="The request will be closed as CANCELLED. This cannot be undone.">
            Cancel Request
          </l:confirmationLink>
        </p>
      </j:if>
    </l:main-panel>
  </l:layout>
</j:jelly>
