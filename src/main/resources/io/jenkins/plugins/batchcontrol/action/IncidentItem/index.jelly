<?jelly escape-by-default='true'?>
<!-- e2e-03 DEF-09: a refused acknowledge, resolve, comment or rerun comes back to this page
     (ui.FormErrors) with the message next to the field or above the form and the input kept;
     form targets are absolute because the refusal is rendered at the POST URL. DEF-12: the rerun
     form is offered only to a user who can submit it (Request + Job/Read on the job, D-38a). -->
<j:jelly xmlns:j="jelly:core" xmlns:l="/lib/layout" xmlns:f="/lib/form"
         xmlns:bc="/io/jenkins/plugins/batchcontrol/tags">
  <l:layout title="Incident ${it.id}" type="one-column" permissions="${it.viewPermissions}">
    <l:main-panel>
      <l:app-bar title="Incident ${it.id}"/>
      <bc:tabs active="incidents"/>
      <j:set var="base" value="${rootURL}/batch-control/incidents/${it.id}/"/>
      <!-- DEF-09: a refusal whose form is no longer shown (the incident moved on meanwhile) is
           reported here, above the current state. -->
      <j:if test="${!it.canAcknowledge}">
        <bc:formError errors="${it.formErrors('acknowledge')}"/>
      </j:if>
      <j:if test="${!it.canResolve}">
        <bc:formError errors="${it.formErrors('resolve')}"/>
      </j:if>
      <j:if test="${!it.canRerun or empty(it.approverOptions)}">
        <bc:formError errors="${it.formErrors('rerun')}"/>
      </j:if>

      <table class="jenkins-table jenkins-table--small">
        <tbody>
          <tr>
            <th style="text-align: left; width: 12rem;">Run</th>
            <td>
              <j:choose>
                <j:when test="${it.runUrl != null}">
                  <a class="model-link" href="${rootURL}/${it.runUrl}">${it.incident.runId}</a>
                </j:when>
                <j:otherwise>${it.incident.runId}</j:otherwise>
              </j:choose>
            </td>
          </tr>
          <tr><th style="text-align: left;">Job</th><td>${it.incident.jobFullName}</td></tr>
          <tr><th style="text-align: left;">Result</th><td>${it.incident.result}</td></tr>
          <tr><th style="text-align: left;">Status</th><td>${it.incident.status}</td></tr>
          <tr><th style="text-align: left;">Created</th><td>${it.format(it.createdAt)}</td></tr>
          <j:if test="${it.incident.resolvedByRunId != null}">
            <tr>
              <th style="text-align: left;">Resolved by run</th>
              <td>
                <j:choose>
                  <j:when test="${it.resolvedByRunUrl != null}">
                    <a class="model-link" href="${rootURL}/${it.resolvedByRunUrl}">${it.incident.resolvedByRunId}</a>
                  </j:when>
                  <j:otherwise>${it.incident.resolvedByRunId}</j:otherwise>
                </j:choose>
              </td>
            </tr>
          </j:if>
          <j:if test="${!empty(it.incident.rerunRequestIds)}">
            <tr>
              <th style="text-align: left;">Rerun requests</th>
              <td>
                <!-- Linked only for a user who may open the Run Requests screen (SPEC item 2). -->
                <j:set var="links" value="${it.links}"/>
                <j:set var="requestLinks" value="${links.requests}"/>
                <j:forEach var="rid" items="${it.incident.rerunRequestIds}">
                  <j:choose>
                    <j:when test="${requestLinks and links.request(rid)}">
                      <a href="${rootURL}/batch-control/requests/${rid}/" style="margin-right: 0.5rem;">${rid}</a>
                    </j:when>
                    <j:otherwise>
                      <span style="margin-right: 0.5rem;">${rid}</span>
                    </j:otherwise>
                  </j:choose>
                </j:forEach>
              </td>
            </tr>
          </j:if>
        </tbody>
      </table>

      <h2>Parameters</h2>
      <j:choose>
        <j:when test="${empty(it.incident.parameters)}">
          <p>No parameters.</p>
        </j:when>
        <j:otherwise>
          <table class="jenkins-table jenkins-table--small">
            <thead>
              <tr><th>Name</th><th>Value</th></tr>
            </thead>
            <tbody>
              <j:forEach var="p" items="${it.incident.parameters.entrySet()}">
                <tr>
                  <td>${p.key}</td>
                  <td style="white-space: pre-wrap;">${p.value}</td>
                </tr>
              </j:forEach>
            </tbody>
          </table>
        </j:otherwise>
      </j:choose>

      <h2>History</h2>
      <table class="jenkins-table jenkins-table--small">
        <thead>
          <tr><th>Status</th><th>By</th><th>At</th><th>Comment</th></tr>
        </thead>
        <tbody>
          <j:forEach var="t" items="${it.incident.transitions}">
            <tr>
              <td>${t.status}</td>
              <td>${t.by}</td>
              <td>${it.format(t.at)}</td>
              <td style="white-space: pre-wrap;">${t.comment}</td>
            </tr>
          </j:forEach>
        </tbody>
      </table>

      <h2>Console Log Tail</h2>
      <j:choose>
        <j:when test="${empty(it.incident.logTail)}">
          <p>No log excerpt was captured.</p>
        </j:when>
        <j:otherwise>
          <!-- Escaped by default: console output is untrusted text. Secrets known to Jenkins
               were masked at capture time; other secrets printed to the console may not be
               (documented detection limit, D-19). -->
          <pre style="overflow-x: auto; max-height: 30rem;">${it.logTailText}</pre>
        </j:otherwise>
      </j:choose>

      <j:if test="${it.canAcknowledge}">
        <h2>Acknowledge</h2>
        <j:set var="ackErrors" value="${it.formErrors('acknowledge')}"/>
        <bc:formError errors="${ackErrors}"/>
        <f:form method="post" action="${base}acknowledge" name="acknowledge">
          <f:entry title="Comment (optional)">
            <f:textarea name="comment" value="${ackErrors.value('comment')}"/>
            <bc:fieldError errors="${ackErrors}" field="comment"/>
          </f:entry>
          <f:bottomButtonBar>
            <f:submit value="Acknowledge"/>
          </f:bottomButtonBar>
        </f:form>
      </j:if>

      <j:if test="${it.canResolve}">
        <h2>Resolve</h2>
        <j:set var="resolveErrors" value="${it.formErrors('resolve')}"/>
        <bc:formError errors="${resolveErrors}"/>
        <f:form method="post" action="${base}resolve" name="resolve">
          <f:entry title="Comment (optional)" description="Resolution is final: a resolved incident cannot be reopened (comments stay possible).">
            <f:textarea name="comment" value="${resolveErrors.value('comment')}"/>
            <bc:fieldError errors="${resolveErrors}" field="comment"/>
          </f:entry>
          <f:bottomButtonBar>
            <f:submit value="Resolve"/>
          </f:bottomButtonBar>
        </f:form>
      </j:if>

      <j:if test="${it.canComment}">
        <h2>Add Comment</h2>
        <!-- The form name must differ from the control name it contains: with both called
             "comment" the entry rendered without its label and the textarea collapsed
             (e2e-01, incident-detail-open.jpg). Same shape as the Acknowledge form above. -->
        <j:set var="commentErrors" value="${it.formErrors('comment')}"/>
        <bc:formError errors="${commentErrors}"/>
        <f:form method="post" action="${base}comment" name="addComment">
          <f:entry title="Comment (required)"
                   description="The comment is appended to the incident history; the status does not change.">
            <f:textarea name="comment" value="${commentErrors.value('comment')}"/>
            <bc:fieldError errors="${commentErrors}" field="comment"/>
          </f:entry>
          <f:bottomButtonBar>
            <f:submit value="Add Comment"/>
          </f:bottomButtonBar>
        </f:form>
      </j:if>

      <j:if test="${it.canRerun}">
        <h2>Request Rerun</h2>
        <!-- e2e-04 DD-06: the rerun's parameters are fixed and its reason is generated, as the
             README says; UX-19: the ordinary run request form is linked for this viewer, who may
             use it (isCanRerun is the same Request + Item/Read test, D-38a). -->
        <p class="jenkins-description">
          Creates a run request for this job, linked to this incident. It uses the original
          parameters, which cannot be changed here, and a reason generated from the incident; you
          only choose the approvers.
          <j:if test="${it.jobUrl != null}">
            To run with other parameters, submit an ordinary run request on the job's
            <a href="${rootURL}/${it.jobUrl}batch-control/">run request form</a> instead; that
            request is not linked to this incident.
          </j:if>
        </p>
        <j:choose>
          <j:when test="${empty(it.approverOptions)}">
            <div class="jenkins-alert jenkins-alert-warning">
              No approvers are configured. Ask an administrator to add approvers in the Batch Control global configuration.
            </div>
          </j:when>
          <j:otherwise>
            <j:set var="rerunErrors" value="${it.formErrors('rerun')}"/>
            <bc:formError errors="${rerunErrors}"/>
            <f:form method="post" action="${base}rerun" name="rerun">
              <!-- D-37: repeated "approvers" fields, one user id per checked box, like the job's
                   own request form (U-16). -->
              <f:entry title="Approvers" description="Any one of the checked approvers may decide."
                       help="/plugin/batch-control/help/approvers.html">
                <j:set var="singleApprover" value="${it.approverOptions.size() == 1}"/>
                <j:forEach var="a" items="${it.approverOptions}" varStatus="s">
                  <div class="jenkins-!-margin-bottom-1">
                    <f:checkbox name="approvers" value="${a}" id="batch-control-rerun-approver-${s.index}"
                                title="${a}" checked="${rerunErrors.present ? rerunErrors.checked('approvers', a) : singleApprover}"/>
                  </div>
                </j:forEach>
                <bc:fieldError errors="${rerunErrors}" field="approvers"/>
              </f:entry>
              <f:bottomButtonBar>
                <f:submit value="Request Rerun"/>
              </f:bottomButtonBar>
            </f:form>
          </j:otherwise>
        </j:choose>
      </j:if>
      <!-- DEF-12 / U-24: a user who cannot rerun is told who can, instead of being given a
           form the server refuses. -->
      <j:if test="${!it.canRerun and it.jobAvailable}">
        <h2>Request Rerun</h2>
        <!-- e2e-04 FD-10: the rerun is submitted from this page, which needs Batch Control/
             ViewHistory as well, so a user with only Request and Job/Read cannot do it. Name the
             whole permission set, and the fallback that such a user can reach. -->
        <p class="jenkins-description">
          A rerun is a run request for this job with the original parameters, linked to this
          incident. You may not submit one. It can be requested from this page by a user who can
          open this page (<b>Batch Control/ViewHistory</b>) and also holds
          <b>Batch Control/Request</b> and <b>Job/Read</b> on the job, or by a Jenkins
          administrator; ask one of them.
        </p>
        <!-- e2e-04 UX-19: this viewer may not submit run requests for the job, so the run request
             form is not linked (it would answer 404 or refuse); the job page is, and its sidebar
             carries the Request Run entry for users who may use it. -->
        <p class="jenkins-description">
          A user with Batch Control/Request and Job/Read can instead submit an ordinary run
          request from the Request Run entry on the page of
          <a class="model-link" href="${rootURL}/${it.jobUrl}">${it.incident.jobFullName}</a>; that request is not
          linked to this incident.
        </p>
      </j:if>
    </l:main-panel>
  </l:layout>
</j:jelly>
