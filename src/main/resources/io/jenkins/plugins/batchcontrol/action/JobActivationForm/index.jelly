<?jelly escape-by-default='true'?>
<!-- SPEC item 6a: the activation request form. The action is the one that can change anything
     (ACTIVATE when the job is not activated, HOLD when it is), posted as the "action" query
     parameter with the reason and the repeated "approvers" field to JobActivationForm#doSubmit. -->
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:l="/lib/layout" xmlns:f="/lib/form"
         xmlns:bc="/io/jenkins/plugins/batchcontrol/tags">
  <l:layout title="Activation - ${it.item.fullDisplayName}" permissions="${it.viewPermissions}">
    <st:include page="sidepanel.jelly" it="${it.item}"/>
    <!-- e2e-03 DEF-06: see JobRequestAction/activation.jelly. -->
    <j:if test="${activationCrumb}">
      <l:breadcrumb title="Activation" href="${rootURL}/${it.item.url}batch-control/activation"/>
    </j:if>
    <l:main-panel>
      <l:app-bar title="Activation: ${it.item.fullDisplayName}"/>

      <j:set var="state" value="${it.state}"/>
      <table class="jenkins-table jenkins-table--small">
        <tbody>
          <tr>
            <th style="text-align: left; width: 12rem;">State</th>
            <td>
              <j:choose>
                <j:when test="${it.carrier != null and it.carrierReadable}">Carried by ${it.carrier.fullDisplayName}</j:when>
                <j:when test="${it.carrier != null}">Managed by an item you cannot see</j:when>
                <j:when test="${it.activated}">Activated</j:when>
                <j:when test="${it.held}">On hold</j:when>
                <j:otherwise>Not activated</j:otherwise>
              </j:choose>
            </td>
          </tr>
          <j:if test="${state != null and state.activatedBy != null}">
            <tr>
              <th style="text-align: left;">Activated by</th>
              <td>${state.activatedBy} (${it.format(state.activatedAt)})</td>
            </tr>
          </j:if>
          <j:if test="${state != null and state.deactivatedBy != null}">
            <tr>
              <th style="text-align: left;">Put on hold by</th>
              <td>${state.deactivatedBy} (${it.format(state.deactivatedAt)})</td>
            </tr>
          </j:if>
        </tbody>
      </table>

      <j:if test="${!it.runControlled}">
        <div class="jenkins-alert jenkins-alert-info" style="margin-top: 1rem;">
          Run control is off, so activation has no effect right now. It applies as soon as run
          control is turned on.
        </div>
      </j:if>

      <j:set var="pending" value="${it.pendingRequests}"/>
      <j:if test="${!empty(pending)}">
        <h2>Pending Requests</h2>
        <ul>
          <j:forEach var="r" items="${pending}">
            <li>
              <a href="${rootURL}/batch-control/activations/${r.id}/">${r.id}</a>:
              ${it.actionLabel(r.action)} requested by ${r.requester} on ${it.format(r.createdAt)}
            </li>
          </j:forEach>
        </ul>
      </j:if>

      <j:choose>
        <j:when test="${it.carrier != null}">
          <p>
            <j:choose>
              <j:when test="${it.carrierReadable}">
                This job is generated by ${it.carrier.fullDisplayName}, which carries its activation.
              </j:when>
              <j:otherwise>This job's activation is managed by an item you cannot see.</j:otherwise>
            </j:choose>
            Make activation or hold requests on the folder that carries it.
          </p>
        </j:when>
        <j:when test="${empty(it.approverOptions)}">
          <div class="jenkins-alert jenkins-alert-warning" style="margin-top: 1rem;">
            No approvers are configured. Ask an administrator to add approvers in the Batch Control global configuration.
          </div>
        </j:when>
        <j:otherwise>
          <h2>
            <j:choose>
              <j:when test="${it.nextAction == 'HOLD'}">Request a Hold: HOLD (take out of service)</j:when>
              <j:otherwise>Request Activation: ACTIVATE (put into service)</j:otherwise>
            </j:choose>
          </h2>
          <p class="jenkins-description">
            <j:choose>
              <j:when test="${it.nextAction == 'HOLD'}">
                Once any one of the checked approvers approves, unattended triggers (timer,
                upstream, SCM) stop starting this
                <j:choose><j:when test="${it.folder}">folder's jobs</j:when><j:otherwise>job</j:otherwise></j:choose>.
                Disable Project remains available as an immediate stop.
              </j:when>
              <j:otherwise>
                Once any one of the checked approvers approves, unattended triggers (timer,
                upstream, SCM) may start this
                <j:choose><j:when test="${it.folder}">folder's jobs</j:when><j:otherwise>job</j:otherwise></j:choose>,
                as far as their own trigger settings allow.
              </j:otherwise>
            </j:choose>
          </p>
          <!-- The action travels in the query string, not as a field named "action": a form
               control of that name would shadow the form element's own "action" property in
               the browser (DOM clobbering) and break the standard form submission script. -->
          <!-- e2e-03 DEF-09: a refused submission comes back here with the messages next to the
               fields and the input kept (ui.FormErrors). -->
          <j:set var="errors" value="${it.formErrors}"/>
          <bc:formError errors="${errors}"/>
          <f:form method="post" action="${rootURL}/${it.item.url}batch-control/activation/submit?action=${it.nextAction}" name="batch-control-activation">
            <f:entry title="Reason" description="Why this change is needed (required).">
              <f:textarea name="reason" value="${errors.value('reason')}"/>
              <bc:fieldError errors="${errors}" field="reason"/>
            </f:entry>
            <f:entry title="Approvers" description="Any one of the checked approvers may decide."
                     help="/plugin/batch-control/help/approvers.html">
              <j:set var="singleApprover" value="${it.approverOptions.size() == 1}"/>
              <j:forEach var="a" items="${it.approverOptions}" varStatus="s">
                <div class="jenkins-!-margin-bottom-1">
                  <f:checkbox name="approvers" value="${a}" id="batch-control-approver-${s.index}"
                              title="${a}" checked="${errors.present ? errors.checked('approvers', a) : singleApprover}"/>
                </div>
              </j:forEach>
              <bc:fieldError errors="${errors}" field="approvers"/>
            </f:entry>
            <f:bottomButtonBar>
              <f:submit value="Submit Request"/>
              <a href="${rootURL}/${it.item.url}" class="jenkins-button">Cancel</a>
            </f:bottomButtonBar>
          </f:form>
        </j:otherwise>
      </j:choose>
    </l:main-panel>
  </l:layout>
</j:jelly>
