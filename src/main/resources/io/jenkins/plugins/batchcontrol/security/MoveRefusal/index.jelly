<?jelly escape-by-default='true'?>
<!-- SPEC item 8 (D-59, feedback in the D-48 style): the browser page of MoveRefusal, answered with
     HTTP 403 after a move was refused (the message says nothing was moved). Only the refusal
     message and, for a viewer who may read the item (MoveRefusal#getItemUrl non-null), a link
     named after the item are rendered; both are escaped by default (item names are user input).
     No script and no Back link, the breadcrumb bar leads back. -->
<j:jelly xmlns:j="jelly:core" xmlns:l="/lib/layout">
  <l:layout title="Move not allowed" type="one-column">
    <l:main-panel>
      <l:app-bar title="Move not allowed"/>
      <div class="jenkins-alert jenkins-alert-warning" role="alert">
        <p style="margin-bottom: 0;">${it.message}</p>
        <j:if test="${it.itemUrl != null}">
          <div class="jenkins-!-margin-top-2"><a href="${rootURL}/${it.itemUrl}">${it.itemFullName}</a></div>
        </j:if>
      </div>
    </l:main-panel>
  </l:layout>
</j:jelly>
