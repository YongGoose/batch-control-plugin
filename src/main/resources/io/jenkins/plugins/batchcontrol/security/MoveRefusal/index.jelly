<?jelly escape-by-default='true'?>
<!-- SPEC item 8 (D-59, feedback in the D-48 style): the browser page of MoveRefusal, answered with
     HTTP 403 after a move was refused (the message says nothing was moved). Only the refusal message (escaped by
     default; it may contain item names, which are user input) and constant text are rendered; no
     script and no Back link, the breadcrumb bar leads back. -->
<j:jelly xmlns:j="jelly:core" xmlns:l="/lib/layout">
  <l:layout title="Move not allowed" type="one-column">
    <l:main-panel>
      <l:app-bar title="Move not allowed"/>
      <div class="jenkins-alert jenkins-alert-warning" role="alert">
        <p style="margin-bottom: 0;">${it.message}</p>
      </div>
    </l:main-panel>
  </l:layout>
</j:jelly>
