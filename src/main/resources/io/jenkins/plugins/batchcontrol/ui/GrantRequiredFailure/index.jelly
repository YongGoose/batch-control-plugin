<?jelly escape-by-default='true'?>
<!-- e2e-03 DEF-26 (SPEC item 8): the refusal page of a change that needs a permission window.
     The new-request form is linked only for a user who may open the Grants screen and request a
     window (GrantRequiredFailure#isCanRequest); anyone else is told whom to ask, never sent to a
     page that answers 403. Only the item name and constant text are rendered; no script. -->
<j:jelly xmlns:j="jelly:core" xmlns:l="/lib/layout">
  <l:layout title="Permission window required" type="one-column">
    <l:main-panel>
      <l:app-bar title="Permission window required"/>
      <j:set var="item" value="${it.item}"/>
      <div class="jenkins-alert jenkins-alert-warning" role="alert">
        <p>
          <strong>Nothing was changed.</strong>
          Change control is on: this change to <strong>${it.itemFullName}</strong> needs an
          approved <strong>${it.actionLabel}</strong> permission window, and you do not hold one.
        </p>
        <j:choose>
          <j:when test="${it.canRequest}">
            <p style="margin-bottom: 0;">
              <a href="${rootURL}/${it.requestUrl}">Request a ${it.actionLabel} window</a> for it;
              try again once the request is approved.
            </p>
          </j:when>
          <j:otherwise>
            <p style="margin-bottom: 0;">
              You may not request permission windows yourself. Ask a Jenkins administrator to give
              you the Batch Control/RequestGrant permission, or to make this change for you.
            </p>
          </j:otherwise>
        </j:choose>
      </div>
      <j:if test="${item != null}">
        <p><a href="${rootURL}/${item.url}">Back to ${item.fullDisplayName}</a></p>
      </j:if>
    </l:main-panel>
  </l:layout>
</j:jelly>
