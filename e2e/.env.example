# Copy to e2e/.env and change the values. Never commit e2e/.env.
# Consumed by casc/jenkins.yaml (the accounts of checklist 1.2).
BC_ADMIN_PASSWORD=change-me-admin
# approver-1, approver-2
BC_APPROVER_PASSWORD=change-me-approver
BC_REQUESTER_PASSWORD=change-me-requester
# manager, approver-disc, approver-unlisted, reqonly, auditor, nobc, configurer
BC_OTHER_PASSWORD=change-me-other
# Host ports: Jenkins, and the mail sink UI/API (mailpit).
BC_PORT=8080
BC_MAIL_PORT=8025
