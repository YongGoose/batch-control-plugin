# Copy to e2e/.env and change the values. Never commit e2e/.env.
# Accounts created by e2e/init.groovy.d/00-security.groovy.
BC_ADMIN_PASSWORD=change-me-admin
BC_APPROVER_PASSWORD=change-me-approver
BC_REQUESTER_PASSWORD=change-me-requester
# Host port the Jenkins under test is published on.
BC_PORT=8080
