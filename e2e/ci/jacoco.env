# JaCoCo pins for the e2e coverage (compose.coverage.yml, ci/coverage-diff.py), read by
# ci/fetch-jacoco.sh and ci/coverage-diff.py. Artefacts from Maven Central:
#   org.jacoco:org.jacoco.agent:<version>:runtime  -> ci/.cache/jacoco/jacocoagent.jar
#   org.jacoco:org.jacoco.cli:<version>:nodeps     -> ci/.cache/jacoco/jacococli.jar
# The sha256 values were computed on 2026-10-05 from downloads whose sha1 matched the
# .sha1 files published next to them on Maven Central (Central publishes no .sha256 for
# these artefacts). Changing the version means updating both checksums.
JACOCO_VERSION=0.8.15
JACOCO_AGENT_SHA256=fb5b0036a0899ea97edfa0fc2c7985b55f3f7c5695028163e5e60d4f3cf6075d
JACOCO_CLI_SHA256=d2b74b20b415163c1f53261e7c5ef4445b788327094208ff821e0c2baf9bc8f1
